<Window Style="{DynamicResource AppWindowRenderingStyle}" x:Class="PreySense.Frontend.Views.FanCurveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PreySense.Frontend.Controls"
        Title="PreySense • Fans" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource AppFontFamily}">
    <Border Style="{DynamicResource AppWindowShellStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <controls:WindowTitleBar Title="Fans"/>
            <StackPanel Margin="{StaticResource WindowContentMargin}">
                <controls:SettingDropdownRow x:Name="ProfileRow" Title="Profile Mode"
                    ItemsSource="{Binding FanCurveModeNames}" DropdownWidth="140" Margin="0,0,0,12"/>
                <UniformGrid Columns="3" Margin="{StaticResource StandardSectionMargin}">
                    <RadioButton x:Name="AutoOption" Content="Auto" GroupName="FanControl" Style="{StaticResource SegmentedTabRadioStyle}" Checked="FanMode_Changed"/>
                    <RadioButton x:Name="MaxOption" Content="Max" GroupName="FanControl" Style="{StaticResource SegmentedTabRadioStyle}" Checked="FanMode_Changed"/>
                    <RadioButton x:Name="CustomOption" Content="Custom" GroupName="FanControl" Style="{StaticResource SegmentedTabRadioStyle}" Checked="FanMode_Changed"/>
                </UniformGrid>
                <controls:LabeledTabSwitcher x:Name="FanTabs" Margin="{StaticResource StandardSectionMargin}"
                    LeftText="CPU Fan" RightText="GPU Fan"
                    LeftIcon="pack://application:,,,/PreySense;component/Resources/icons8-processor-32.png"
                    RightIcon="pack://application:,,,/PreySense;component/Resources/icons8-video-card-32.png"
                    SelectionChanged="FanTab_Changed"/>
                <StackPanel>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="CpuTemperatureReading" Text="—" FontWeight="SemiBold"/>
                                <TextBlock Text="  •  " Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="CpuFanReading" Text="—" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="GpuTemperatureReading" Text="—" FontWeight="SemiBold"/>
                                <TextBlock Text="  •  " Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="GpuFanReading" Text="—" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel x:Name="CurveEditor">
                    <controls:WpfFanCurveControl x:Name="Curve" Height="230"/>
                    <controls:SettingValueRow x:Name="RowTemp" Title="Temp" Minimum="40" Maximum="100" Unit="&#xB0;C" ValueCommitted="StageField_Committed" Margin="0,8,0,0"/>
                    <controls:SettingValueRow x:Name="RowDuty" Title="CPU Cooling Boost" Minimum="0" Maximum="100" Unit="%" ValueCommitted="StageField_Committed"/>
                    <Grid x:Name="EstimatedRpmRow" Margin="{DynamicResource StandardRowMargin}"
                          IsEnabled="{Binding IsEnabled, ElementName=RowDuty}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Estimated RPM" Style="{DynamicResource SettingLabelStyle}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="EstimatedRpmReading" Text="—" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                     Focusable="False" IsTabStop="False" MinWidth="72"
                                     Style="{DynamicResource CompactValueTextBoxStyle}"/>
                            <TextBlock Text="RPM" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                </StackPanel>
                <TextBlock x:Name="OperationError" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
            <UniformGrid x:Name="FooterPanel" Columns="2" Style="{StaticResource WindowFooterPanelStyle}">
                <Button Content="Reset" Click="Reset_Click" Style="{StaticResource WindowFooterButtonStyle}"/>
                <Button Content="Save" Click="Save_Click" Style="{StaticResource WindowFooterButtonStyle}"/>
            </UniformGrid>
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
