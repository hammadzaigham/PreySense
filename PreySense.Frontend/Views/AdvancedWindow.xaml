<Window x:Class="PreySense.Frontend.Views.AdvancedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PreySense.Frontend.Controls"
        Title="PreySense • Advanced"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Border Style="{DynamicResource AppWindowShellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:WindowTitleBar Grid.Row="0" Title="Advanced"/>

            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="{StaticResource WindowContentMargin}">
                    <Border Style="{StaticResource OriginalSectionPanelStyle}" CornerRadius="4" Margin="{StaticResource StandardSectionMargin}">
                        <StackPanel>
                            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
                                <TextBlock Text="Power Profiles" Style="{StaticResource OriginalSectionTitleStyle}"/>
                            </Grid>
                            <controls:SettingDropdownRow Title="On Battery"
                                                         ItemsSource="{Binding SourceProfileNames}"
                                                         SelectedIndex="{Binding BatteryPowerModeIndex, Mode=TwoWay}"
                                                         DropdownWidth="160"/>

                            <controls:SettingSwitchRow Title="Energy Saver on Battery"
                                                      IsChecked="{Binding IsBatteryEnergySaverEnabled, Mode=TwoWay}"/>

                            <controls:SettingDropdownRow Title="On USB-C"
                                                         ItemsSource="{Binding SourceProfileNames}"
                                                         SelectedIndex="{Binding UsbCPowerModeIndex, Mode=TwoWay}"
                                                         DropdownWidth="160"/>

                            <controls:SettingDropdownRow Title="On AC"
                                                         ItemsSource="{Binding SourceProfileNames}"
                                                         SelectedIndex="{Binding AcPowerModeIndex, Mode=TwoWay}"
                                                         DropdownWidth="160"/>
                        </StackPanel>
                    </Border>

                    <Separator Margin="0,6,0,12"/>

                    <Border Style="{StaticResource OriginalSectionPanelStyle}" CornerRadius="4" Margin="{StaticResource StandardSectionMargin}">
                        <StackPanel>
                            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-processor-32.png" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ACPI Override" Style="{StaticResource OriginalSectionTitleStyle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding AcpiOverrideStatus}" HorizontalAlignment="Right" Margin="8,0,0,0" FontSize="{DynamicResource FontSizeSectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>

                            <controls:SettingActionRow Title="Install to USB Drive"
                                                       ActionText="Install"
                                                       Command="{Binding InstallOpenCoreToUsbCommand}"/>

                            <controls:SettingActionRow Title="Install to Boot Drive"
                                                       ActionText="{Binding BootDriveActionText}"
                                                       SecondaryActionText="Re-install"
                                                       SecondaryActionVisibility="{Binding ReinstallOpenCoreVisibility}"
                                                       SecondaryCommand="{Binding ReinstallOpenCoreCommand}"
                                                       Command="{Binding ToggleOpenCoreBootDriveCommand}">
                                <controls:SettingActionRow.Style>
                                    <Style TargetType="controls:SettingActionRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:SettingActionRow.Style>
                            </controls:SettingActionRow>

                            <TextBlock Text="{Binding AcpiFilesNotification}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningTextBrush}" Margin="0,4,0,8"
                                       Visibility="{Binding AcpiFilesNotificationVisibility}"/>

                            <Separator Margin="0,12"/>

                            <controls:SettingActionRow Title="Factory Defaults"
                                                       ActionText="View"
                                                       Command="{Binding ViewFactoryDefaultsCommand}"/>

                            <controls:SettingSwitchRow Title="Enable ACPI Override"
                                                      IsChecked="{Binding IsAcpiOverrideEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanEnableAcpiOverride}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
