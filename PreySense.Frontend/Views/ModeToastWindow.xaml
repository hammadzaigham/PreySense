<Window Style="{DynamicResource AppWindowRenderingStyle}" x:Class="PreySense.Frontend.Views.ModeToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:PreySense.Frontend.Services"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        services:WindowSystemShadow.Enable="False"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        MinWidth="160"
        MaxWidth="220"
        Height="40"
        SizeToContent="Width"
        ResizeMode="NoResize">

    <Border x:Name="ToastBorder"
            Background="{DynamicResource ToastSurfaceBrush}"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="20"
            Padding="12,0">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Path x:Name="IconPathShape" Width="18" Height="18" Stretch="Uniform"
                  Fill="{DynamicResource IconForegroundBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="ModeLabel" Text="Balanced" Margin="9,0,0,0"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center"
                       VerticalAlignment="Center" FontFamily="Segoe UI"
                       FontSize="{DynamicResource FontSizeBody}" FontWeight="Medium"/>
        </StackPanel>
    </Border>
</Window>

