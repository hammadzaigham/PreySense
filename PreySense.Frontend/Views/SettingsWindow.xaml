<Window Style="{DynamicResource AppWindowRenderingStyle}" x:Class="PreySense.Frontend.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PreySense.Frontend.Controls"
        mc:Ignorable="d"
        Title="PreySense • Settings"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        ResizeMode="NoResize">

    <Border Style="{DynamicResource AppWindowShellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Custom Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Settings Content -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <controls:WindowTitleBar Grid.Row="0" Title="Settings"/>

            <!-- Content Area with consistent margins and spacing -->
            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="{StaticResource WindowContentMargin}">

                    <!-- Section: General Policies -->
                    <Border Style="{StaticResource OriginalSectionPanelStyle}" CornerRadius="4" Margin="{StaticResource StandardSectionMargin}">
                        <StackPanel>
                            <!-- Run on Startup Toggle -->
                            <controls:SettingSwitchRow Title="Run on Startup"
                                                      IsChecked="{Binding IsRunOnStartupEnabled, Mode=TwoWay}" 
                                                      Command="{Binding ToggleRunOnStartupCommand}"/>

                            <controls:SettingDropdownRow x:Name="LanguageSelector"
                                                         Title="Language"
                                                         DropdownWidth="220"
                                                         SelectionChanged="LanguageSelector_SelectionChanged">
                                <ComboBoxItem Content="English" Tag="en-US"/>
                                <ComboBoxItem Content="Simplified Chinese" Tag="zh-CN"/>
                                <ComboBoxItem Content="Hindi" Tag="hi-IN"/>
                                <ComboBoxItem Content="Spanish" Tag="es-ES"/>
                                <ComboBoxItem Content="French" Tag="fr-FR"/>
                            </controls:SettingDropdownRow>

                            <controls:SettingSwitchRow Title="Theme"
                                                      IsChecked="{Binding IsLightTheme, Mode=TwoWay}"
                                                      OnText="Light"
                                                      OffText="Dark"
                                                      SwitchWidth="92"/>

                            <controls:SettingSwitchRow Title="Acer Services"
                                                      IsChecked="{Binding IsAcerServicesEnabled, Mode=OneWay}"
                                                      Command="{Binding ToggleAcerServicesDebloaterCommand}"
                                                      OnText="Enabled"
                                                      OffText="Disabled"
                                                      SwitchWidth="120"/>

                            <controls:SettingSwitchRow Title="Battery Limit"
                                                      IsChecked="{Binding IsBatteryLimitEnabled, Mode=OneWay}"
                                                      OnText="80%"
                                                      OffText="100%"
                                                      SwitchWidth="92"
                                                      Command="{Binding ToggleBatteryLimitCommand}"/>
                        </StackPanel>
                    </Border>

                    <Separator Margin="0,4,0,12"/>

                    <Border Style="{StaticResource OriginalSectionPanelStyle}" CornerRadius="4" Margin="{StaticResource StandardSectionMargin}">
                        <StackPanel>
                            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
                                <TextBlock Text="Power Profiles" Style="{StaticResource OriginalSectionTitleStyle}"/>
                            </Grid>
                            <controls:SettingDropdownRow Title="On Battery"
                                                         ItemsSource="{Binding SourceProfileNames}"
                                                         SelectedIndex="{Binding BatteryPowerModeIndex, Mode=TwoWay}"
                                                         DropdownWidth="160"/>

                            <controls:SettingSwitchRow Title="Energy Saver on Battery"
                                                      IsChecked="{Binding IsBatteryEnergySaverEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <controls:SettingDropdownRow Title="On AC"
                                                         ItemsSource="{Binding SourceProfileNames}"
                                                         SelectedIndex="{Binding AcPowerModeIndex, Mode=TwoWay}"
                                                         DropdownWidth="160"/>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>




