<Window x:Class="PreySense.Frontend.Views.ModeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PreySense.Frontend.Controls"
        mc:Ignorable="d"
        Title="PreySense • Mode"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Border Style="{DynamicResource AppWindowShellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Custom Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Row 1: ACPI Override Disabled Warning Banner -->
                <RowDefinition Height="Auto"/> <!-- Row 2: Tuning Controls & Action Buttons -->
            </Grid.RowDefinitions>

            <!-- ============================================== -->
            <!-- 0. TITLE BAR                                   -->
            <!-- ============================================== -->
            <controls:WindowTitleBar Grid.Row="0" Title="Tuning"/>

            <!-- ============================================== -->
            <!-- 1. ACPI HARDWARE OVERRIDE DISABLED BANNER      -->
            <!-- ============================================== -->
            <Border Grid.Row="1" Visibility="{Binding AcpiOverrideDisabledBannerVisibility}"
                    Style="{DynamicResource WarningBannerStyle}" Margin="14,8,14,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚠" Foreground="{DynamicResource IconForegroundBrush}" FontSize="{DynamicResource FontSizeSectionTitle}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding AcpiOverrideDisabledBannerText}"
                               Foreground="{DynamicResource WarningTextBrush}" FontSize="{DynamicResource FontSizeBody}" TextWrapping="Wrap" LineHeight="14" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- 2. TUNING CONTROLS CONTAINER (Locked when ACPI Override OFF or OpenCore not loaded) -->
            <!-- ============================================== -->
            <Grid Grid.Row="2" IsEnabled="{Binding IsAcpiOverrideEnabled}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Performance Profile Selector -->
                    <RowDefinition Height="Auto"/> <!-- Scrollable Content Area -->
                    <RowDefinition Height="Auto"/> <!-- Pinned Footer Action Buttons -->
                </Grid.RowDefinitions>

                <!-- PERFORMANCE PROFILE SELECTOR -->
                <Border Grid.Row="0" Style="{StaticResource OriginalSectionPanelStyle}" Margin="14,8,14,8">
                    <StackPanel>
                        <Grid Margin="{StaticResource StandardRowMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Profile Mode" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="ComboModeSelect" Height="28" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBody}" SelectionChanged="ComboModeSelect_SelectionChanged">
                                <ComboBoxItem Content="Eco"/>
                                <ComboBoxItem Content="Quiet"/>
                                <ComboBoxItem Content="Balanced"/>
                                <ComboBoxItem Content="Performance"/>
                                <ComboBoxItem Content="Turbo"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SCROLLABLE CONTENT -->
                <ScrollViewer x:Name="TuningScroll" Grid.Row="1" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,0,14,0">

                        <!-- CPU POWER LIMITS -->
                        <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-processor-32.png" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="CPU Power Limits" Style="{StaticResource OriginalSectionTitleStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <controls:SettingSwitchRow x:Name="SwitchCpuBoost" Title="CPU Boost"/>

                                <controls:SettingValueRow x:Name="RowPl1"
                                                          Title="Sustained Long Power [PL1]"
                                                          Value="55"
                                                          Unit="W"
                                                          ValueAutomationId="ModePl1Value"
                                                          LostFocus="RowPl1_LostFocus"/>

                                <controls:SettingValueRow x:Name="RowPl2"
                                                          Title="Burst Peak Power [PL2]"
                                                          Value="140"
                                                          Unit="W"
                                                          ValueAutomationId="ModePl2Value"
                                                          LostFocus="RowPl2_LostFocus"/>

                                <!-- Tau Duration Slider -->
                                <Grid Margin="{StaticResource StandardRowMargin}">
                                    <StackPanel Margin="0,5,0,0">
                                        <Grid>
                                            <TextBlock Text="Burst Window [Tau]" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="LabelTau" Text="56 s" HorizontalAlignment="Right" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Grid>
                                        <Slider x:Name="SliderTau" Minimum="0" Maximum="11" SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="SliderTau_ValueChanged"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- GPU POWER LIMITS & DYNAMIC BOOST -->
                        <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="0">
                            <StackPanel>
                                <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-video-card-32.png" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="GPU Power Limits" Style="{StaticResource OriginalSectionTitleStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- GPU Power Limit Target Value Box (No maximum clamp) -->
                                <controls:SettingValueRow x:Name="RowGpuPower"
                                                          Title="Baseline + Delta + Boost"
                                                          IsEnabled="False"
                                                          Value="140"
                                                          Unit="W"
                                                          Minimum="1"
                                                          ValueAutomationId="ModeGpuPowerValue"
                                                          LostFocus="RowGpuPower_LostFocus"/>

                                <controls:SettingValueRow x:Name="RowGpuDelta" Title="Delta"
                                                          Unit="W" Minimum="0" Maximum="255"
                                                          ValueAutomationId="ModeGpuDeltaValue" ValueCommitted="GpuOffsets_Committed"/>
                                <controls:SettingValueRow x:Name="RowGpuDynamicBoost" Title="Dynamic Boost"
                                                          Unit="W" Minimum="0" Maximum="255"
                                                          ValueAutomationId="ModeGpuDynamicBoostValue" ValueCommitted="GpuOffsets_Committed"/>

                                <!-- GPU Thermal Trip Point (WMG3 Dynamic Boost Choke) (70°C to 89°C, 1°C steps) -->
                                <Grid Margin="{StaticResource StandardRowMargin}">
                                    <StackPanel Margin="0,6,0,0">
                                        <Grid>
                                            <TextBlock Text="GPU Thermal Trip Point" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding GpuThermalTripPointCelsius, StringFormat='{}{0} °C'}" HorizontalAlignment="Right" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Grid>
                                        <Slider x:Name="SliderGpuTripPoint" Minimum="70" Maximum="89" Value="{Binding GpuThermalTripPointCelsius, Mode=TwoWay}" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="SliderGpuTripPoint_ValueChanged"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- PINNED FOOTER ACTION BUTTONS -->
                <UniformGrid Grid.Row="2" Columns="3" Rows="1" Style="{StaticResource WindowFooterPanelStyle}" Margin="14,8,14,14">
                    <Button x:Name="BtnReset" Content="Reset" Style="{StaticResource WindowFooterButtonStyle}" Click="ResetButton_Click"/>
                    <Button x:Name="BtnApply" Content="Apply" Style="{StaticResource WindowFooterButtonStyle}" Click="ApplyButton_Click"/>
                    <Button x:Name="BtnSave" Content="Save" Style="{StaticResource WindowFooterButtonStyle}" Click="SaveButton_Click"/>
                </UniformGrid>

            </Grid>

        </Grid>
    </Border>
</Window>
