<UserControl x:Class="PreySense.Frontend.Controls.SettingSliderRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootSliderRow">
    <StackPanel Margin="0,2,0,0" HorizontalAlignment="Stretch">
        <Grid>
            <TextBlock Text="{Binding Title, ElementName=RootSliderRow}" Style="{DynamicResource SettingLabelStyle}" HorizontalAlignment="Left" />
            <TextBlock>
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SettingValueStyle}">
                        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="TextAlignment" Value="Right" />
                        <Setter Property="Text" Value="{Binding ValueText, ElementName=RootSliderRow}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ValueText, ElementName=RootSliderRow}" Value="">
                                <Setter Property="Text" Value="{Binding BadgeText, ElementName=RootSliderRow}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ValueText, ElementName=RootSliderRow}" Value="{x:Null}">
                                <Setter Property="Text" Value="{Binding BadgeText, ElementName=RootSliderRow}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <Slider x:Name="InnerSlider"
                Minimum="{Binding Minimum, ElementName=RootSliderRow}"
                Maximum="{Binding Maximum, ElementName=RootSliderRow}"
                Value="{Binding Value, ElementName=RootSliderRow, Mode=TwoWay}"
                SmallChange="{Binding SmallChange, ElementName=RootSliderRow}"
                LargeChange="{Binding LargeChange, ElementName=RootSliderRow}"
                TickFrequency="{Binding TickFrequency, ElementName=RootSliderRow}"
                IsSnapToTickEnabled="{Binding IsSnapToTickEnabled, ElementName=RootSliderRow}"
                MinHeight="20"
                Margin="0,2,0,0"
                ValueChanged="InnerSlider_ValueChanged" />
    </StackPanel>
</UserControl>
