<Window Style="{DynamicResource AppWindowRenderingStyle}" x:Class="PreySense.Frontend.Views.MetricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PreySense.Frontend.Controls"
        mc:Ignorable="d"
        Title="PreySense • Overlay"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        ResizeMode="NoResize">

    <Border Style="{DynamicResource AppWindowShellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <controls:WindowTitleBar Grid.Row="0" Title="Overlay"/>

            <!-- Main Content -->
            <StackPanel Grid.Row="1" Margin="{StaticResource WindowContentMargin}">

                <!-- Display & Appearance Options -->
                <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <!-- Enable Metrics Overlay -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Enable Metrics Overlay" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <controls:RectangularSwitch Grid.Column="1" x:Name="CheckEnableOverlay" Width="56" Height="28" VerticalAlignment="Center" Checked="OverlayToggle_Changed" Unchecked="OverlayToggle_Changed"/>
                        </Grid>

                        <Separator Margin="0,4,0,8"/>

                        <controls:SettingDropdownRow x:Name="DropdownOverlayTheme" Title="Theme" DropdownWidth="140"
                                                     SelectionChanged="OverlayTheme_SelectionChanged">
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="White"/>
                        </controls:SettingDropdownRow>

                        <!-- HUD Scale -->
                        <Grid Margin="{StaticResource StandardRowMargin}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="HUD Scale" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LabelHudScale" Text="100%" HorizontalAlignment="Right" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <Slider x:Name="SliderHudScale" Minimum="50" Maximum="200" Value="100" SmallChange="5" LargeChange="5" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,3,0,0" ValueChanged="SliderHudScale_ValueChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- Background Opacity -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Background Opacity" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LabelOpacity" Text="50%" HorizontalAlignment="Right" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <Slider x:Name="SliderOpacity" Minimum="0" Maximum="100" Value="50" SmallChange="10" LargeChange="10" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,3,0,0" ValueChanged="SliderOpacity_ValueChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- Text Opacity -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Text Opacity" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LabelTextOpacity" Text="100%" HorizontalAlignment="Right" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <Slider x:Name="SliderTextOpacity" Minimum="0" Maximum="100" Value="100" SmallChange="10" LargeChange="10" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,3,0,0" ValueChanged="SliderTextOpacity_ValueChanged"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,4,0,8"/>

                        <!-- Horizontal Position -->
                        <controls:SettingDropdownRow x:Name="DropdownHorizontalPos"
                                                     Title="Horizontal Position"
                                                     SelectionChanged="PositionDropdown_SelectionChanged" />

                        <!-- Vertical Position -->
                        <controls:SettingDropdownRow x:Name="DropdownVerticalPos"
                                                     Title="Vertical Position"
                                                     SelectionChanged="PositionDropdown_SelectionChanged" />

                        <!-- Show FPS Counter -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Show FPS" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <controls:RectangularSwitch Grid.Column="1" x:Name="CheckShowFps" Width="56" Height="28" VerticalAlignment="Center" Checked="SettingChanged" Unchecked="SettingChanged"/>
                        </Grid>

                    </StackPanel>

                </Border>

                <Separator Margin="0,4,0,8"/>

                <Border Style="{StaticResource OriginalSectionPanelStyle}">
                    <StackPanel>
                        <Grid Margin="0,2,0,6">
                            <TextBlock Text="Overlay Metric Slots" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button x:Name="ButtonAddSlot" Content="Add Slot" HorizontalAlignment="Right" Width="88" Height="26" Padding="6,2" Click="ButtonAddSlot_Click"/>
                        </Grid>
                        <StackPanel x:Name="PanelColumnsContainer"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
