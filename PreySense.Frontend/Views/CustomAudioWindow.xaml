<Window Style="{DynamicResource AppWindowRenderingStyle}" x:Class="PreySense.Frontend.Views.CustomAudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PreySense.Frontend.Controls"
        Title="PreySense • Custom Audio"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Border Style="{DynamicResource AppWindowShellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:WindowTitleBar Grid.Row="0" Title="Custom Audio"
                                     Subtitle="{Binding SelectedEndpoint.Title, TargetNullValue=''}"/>

            <StackPanel Grid.Row="1" Margin="{StaticResource WindowContentMargin}">
                <Border Style="{StaticResource OriginalSectionPanelStyle}" CornerRadius="4" Margin="{StaticResource StandardSectionMargin}">
                    <StackPanel>
                        <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
                            <TextBlock Text="Stereo Sound" Style="{StaticResource OriginalSectionTitleStyle}"/>
                        </Grid>
                        <UniformGrid Columns="3" Margin="8,4,8,8" IsEnabled="{Binding CanEdit}">
                            <UniformGrid.Style>
                                <Style TargetType="UniformGrid">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </UniformGrid.Style>
                            <RadioButton Content="Front" GroupName="Stereo" Style="{StaticResource SegmentedTabRadioStyle}"
                                         IsChecked="{Binding IsFront, Mode=TwoWay}"/>
                            <RadioButton Content="Wide" GroupName="Stereo" Style="{StaticResource SegmentedTabRadioStyle}"
                                         IsChecked="{Binding IsWide, Mode=TwoWay}"/>
                            <RadioButton Content="Traditional" GroupName="Stereo" Style="{StaticResource SegmentedTabRadioStyle}"
                                         IsChecked="{Binding IsTraditional, Mode=TwoWay}"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OriginalSectionPanelStyle}" CornerRadius="4" Margin="{StaticResource StandardSectionMargin}">
                    <StackPanel>
                        <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
                            <TextBlock Text="Enhancements" Style="{StaticResource OriginalSectionTitleStyle}"/>
                        </Grid>

                        <controls:SettingSwitchRow Title="Treble Enhance"
                                                  IsChecked="{Binding TrebleEnabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanEdit}"/>
                        <Grid Margin="12,0,12,8" IsEnabled="{Binding TrebleSliderEnabled}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding TrebleLevel, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1" Text="{Binding TrebleLevel, StringFormat={}{0:0}}"
                                       Style="{StaticResource SettingValueStyle}" HorizontalAlignment="Right"/>
                        </Grid>

                        <controls:SettingSwitchRow Title="Bass Boost"
                                                  IsChecked="{Binding BassEnabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanEdit}"/>
                        <Grid Margin="12,0,12,8" IsEnabled="{Binding BassSliderEnabled}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding BassLevel, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1" Text="{Binding BassLevel, StringFormat={}{0:0}}"
                                       Style="{StaticResource SettingValueStyle}" HorizontalAlignment="Right"/>
                        </Grid>

                        <controls:SettingSwitchRow Title="Dialog Clarity"
                                                  IsChecked="{Binding DialogEnabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanEdit}"/>
                        <Grid Margin="12,0,12,8" IsEnabled="{Binding DialogSliderEnabled}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding DialogLevel, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DialogLevel, StringFormat={}{0:0}}"
                                       Style="{StaticResource SettingValueStyle}" HorizontalAlignment="Right"/>
                        </Grid>

                        <controls:SettingSwitchRow Title="Volume Smoothing"
                                                  IsChecked="{Binding VolumeSmoothing, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanEdit}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <UniformGrid Grid.Row="2" Columns="2" Rows="1" Style="{StaticResource WindowFooterPanelStyle}">
                <Button Content="Apply" Style="{StaticResource WindowFooterButtonStyle}"
                        IsEnabled="{Binding CanEdit}"
                        Command="{Binding ApplySettingsCommand}"/>
                <Button Content="Save" Style="{StaticResource WindowFooterButtonStyle}"
                        IsEnabled="{Binding CanEdit}"
                        Command="{Binding SaveSettingsCommand}"/>
            </UniformGrid>
        </Grid>
    </Border>
</Window>
