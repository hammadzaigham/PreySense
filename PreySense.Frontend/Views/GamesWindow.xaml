<Window x:Class="PreySense.Frontend.Views.GamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PreySense.Frontend.Controls"
        Title="PreySense • Games"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Border Style="{DynamicResource AppWindowShellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <controls:WindowTitleBar Grid.Row="0" Title="Games"/>

            <Border Grid.Row="1" Visibility="{Binding AcpiOverrideDisabledBannerVisibility}"
                    Style="{DynamicResource WarningBannerStyle}" Margin="14,8,14,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚠" Foreground="{DynamicResource IconForegroundBrush}" FontSize="{DynamicResource FontSizeSectionTitle}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding AcpiOverrideDisabledBannerText}"
                               Foreground="{DynamicResource WarningTextBrush}" FontSize="{DynamicResource FontSizeBody}" TextWrapping="Wrap" LineHeight="14" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource WindowContentMargin}" IsEnabled="{Binding IsAcpiOverrideEnabled}">
                <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-controller-32.png" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Game Profiles" Style="{StaticResource OriginalSectionTitleStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Add" Style="{StaticResource OriginalRButtonActionStyle}" Height="28" Padding="10,0" Margin="0,0,4,0"
                                        Command="{Binding AddGameProfileCommand}"/>
                                <Button Content="Remove" Style="{StaticResource OriginalRButtonActionStyle}" Height="28" Padding="10,0"
                                        Command="{Binding RemoveSelectedGameProfileCommand}"/>
                            </StackPanel>
                        </Grid>

                        <ListBox ItemsSource="{Binding GameProfiles}"
                                 SelectedItem="{Binding SelectedGameProfile, Mode=TwoWay}"
                                 DisplayMemberPath="DisplayName"
                                 Height="120"
                                 Margin="0,4,0,0"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource BorderSecondBrush}"
                                 Background="{DynamicResource CardBgBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="{DynamicResource FontSizeBody}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="0,0,0,8"
                        IsEnabled="{Binding HasSelectedGameProfile}">
                    <StackPanel>
                        <controls:SettingSwitchRow Title="Apply When Game Launches"
                                                   IsChecked="{Binding SelectedGameEnabled, Mode=TwoWay}"/>
                        <controls:SettingDropdownRow Title="Profile Mode"
                                                     ItemsSource="{Binding GameModeNames}"
                                                     SelectedItem="{Binding SelectedGameModeName, Mode=TwoWay}"
                                                     DropdownWidth="140"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="0,0,0,8"
                        IsEnabled="{Binding HasSelectedGameProfile}">
                    <StackPanel>
                        <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-processor-32.png" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="CPU Power Limits" Style="{StaticResource OriginalSectionTitleStyle}"/>
                            </StackPanel>
                        </Grid>
                        <controls:SettingSwitchRow Title="CPU Boost"
                                                   IsChecked="{Binding SelectedGameCpuBoost, Mode=TwoWay}"/>
                        <controls:SettingValueRow Title="Sustained Long Power [PL1]"
                                                  Value="{Binding SelectedGamePl1, Mode=TwoWay}"
                                                  Unit="W"/>
                        <controls:SettingValueRow Title="Burst Peak Power [PL2]"
                                                  Value="{Binding SelectedGamePl2, Mode=TwoWay}"
                                                  Unit="W"/>
                        <controls:SettingSliderRow Title="Burst Window [Tau]"
                                                   Value="{Binding SelectedGameTauIndex, Mode=TwoWay}"
                                                   ValueText="{Binding SelectedGameTauText}"
                                                   Minimum="0" Maximum="{Binding TauSliderMaximum}"
                                                   SmallChange="1" LargeChange="1" TickFrequency="1"
                                                   IsSnapToTickEnabled="True"
                                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="0,0,0,8"
                        IsEnabled="{Binding HasSelectedGameProfile}">
                    <StackPanel>
                        <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-video-card-32.png" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="GPU Power Limits" Style="{StaticResource OriginalSectionTitleStyle}"/>
                            </StackPanel>
                        </Grid>
                        <controls:SettingValueRow Title="Baseline + Delta + Boost"
                                                  Value="{Binding SelectedGameGpuWatts, Mode=OneWay}"
                                                  IsEnabled="False" Unit="W"
                                                  ValueAutomationId="GameGpuPowerValue"/>
                        <controls:SettingValueRow Title="Delta"
                                                  Value="{Binding SelectedGameGpuDelta, Mode=TwoWay}"
                                                  Minimum="0" Maximum="255" Unit="W"/>
                        <controls:SettingValueRow Title="Dynamic Boost"
                                                  Value="{Binding SelectedGameGpuDynamicBoost, Mode=TwoWay}"
                                                  Minimum="0" Maximum="255" Unit="W"/>
                        <controls:SettingSliderRow Title="GPU Thermal Trip Point"
                                                   Value="{Binding SelectedGameGpuTrip, Mode=TwoWay}"
                                                   ValueText="{Binding SelectedGameGpuTrip, StringFormat={}{0} °C}"
                                                   Minimum="70" Maximum="89"
                                                   SmallChange="1" TickFrequency="1"
                                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2" Style="{StaticResource WindowFooterPanelStyle}" Margin="0,0,0,8"
                             IsEnabled="{Binding HasSelectedGameProfile}">
                    <Button Content="Apply" Style="{StaticResource WindowFooterButtonStyle}"
                            Command="{Binding ApplySelectedGameProfileCommand}"/>
                    <Button Content="Save" Style="{StaticResource WindowFooterButtonStyle}"
                            Command="{Binding SaveSelectedGameProfileCommand}"/>
                </UniformGrid>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
