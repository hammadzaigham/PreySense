<UserControl x:Class="PreySense.Frontend.Controls.SettingActionRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootActionRow">
    <Grid HorizontalAlignment="Stretch" Margin="{DynamicResource StandardRowMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{Binding Title, ElementName=RootActionRow}" Style="{DynamicResource SettingLabelStyle}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{DynamicResource OriginalRButtonActionStyle}" Height="28" Padding="12,0" Margin="0,0,6,0"
                Content="{Binding SecondaryActionText, ElementName=RootActionRow}"
                Command="{Binding SecondaryCommand, ElementName=RootActionRow}"
                Visibility="{Binding SecondaryActionVisibility, ElementName=RootActionRow}"/>
        <Button x:Name="InnerButton" VerticalAlignment="Center"
                Style="{DynamicResource OriginalRButtonActionStyle}"
                Height="28" Padding="12,0"
                Content="{Binding ActionText, ElementName=RootActionRow}"
                Command="{Binding Command, ElementName=RootActionRow}"
                CommandParameter="{Binding CommandParameter, ElementName=RootActionRow}"
                Click="InnerButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>
