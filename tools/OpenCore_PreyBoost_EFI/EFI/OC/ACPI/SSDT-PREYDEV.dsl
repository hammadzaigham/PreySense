                0x99, 0x68, 0x04, 0xE4, 0x84, 0x14, 0x02, 0x72, 0x42, 0x25, 0x40, 0x2C, 0x2F, 0x88, 0x80, 0x9C,
                0xEE, 0xA1, 0x21, 0x20, 0x67, 0x05, 0x11, 0x90, 0x83, 0x3F, 0xE1, 0x04, 0x64, 0x15, 0x5E, 0x80,
                0x98, 0xDA, 0xD7, 0x80, 0x80, 0xAC, 0x1D, 0x44, 0x40, 0x56, 0xED, 0x06, 0x88, 0x65, 0x00, 0x11,
                0x90, 0x15, 0xBF, 0x32, 0x04, 0x64, 0xFD, 0x20, 0x02, 0x72, 0x0C, 0x3F, 0x40, 0x2C, 0x13, 0x88,
                0x80, 0x9C, 0xFD, 0xA1, 0x20, 0xA0, 0xFF, 0x7F, 0x82, 0x4A, 0x0C, 0x01, 0x31, 0x35, 0x6F, 0x15,
                0x01, 0x59, 0x1B, 0x88, 0x80, 0xAC, 0xC4, 0xD2, 0x40, 0x29, 0x88, 0x80, 0x1C, 0xC7, 0x13, 0x10,
                0xCB, 0x06, 0x22, 0x20, 0xCB, 0x7B, 0xF9, 0x08, 0xC8, 0x5A, 0x41, 0x04, 0x64, 0x6D, 0x3F, 0x20,
                0x01, 0x59, 0x29, 0x88, 0x06, 0x49, 0x5C, 0x0D, 0x92, 0x82, 0x68, 0x60, 0xE4, 0x5D, 0xA1, 0x81,
                0x11, 0x10, 0x01, 0x59, 0xC3, 0x93, 0x28, 0x10, 0x51, 0x04, 0x22, 0x20, 0xFF, 0xFF, 0x01
            })


            /*
             * WM01: PreySense Control Method
             * Arg0: Method Index (uint32)
             * Arg1: Method ID / Command ID (uint32)
             * Arg2: Input buffer
             * Return: Output Package or Integer
             *
             * WmiMethodId 1: GetVersion() -> 0x0201 (must match PreySenseInterfaceVersion in preysense.mof)
             * WmiMethodId 2: Ping() -> 0x50524559 ("PREY")
             * WmiMethodId 3: SetCpuPowerLimits(in pl1_mW, in pl2_mW, in tauEncoded, out retCode)
             * WmiMethodId 4: GetCpuPowerLimits(out pl1_mW, out pl2_mW, out tauEncoded, out retCode)
             * WmiMethodId 5: SetGpuPowerLimit(in targetWatts, out retCode)
             * WmiMethodId 6: GetGpuPowerLimit(out targetWatts, out retCode)
             * WmiMethodId 7: SetGpuThermalTripPoint(in tempCelsius, out retCode)
             * WmiMethodId 8: GetGpuThermalTripPoint(out tempCelsius, out retCode)
             * WmiMethodId 11: SetGpuPowerOffsets(in delta, in boost, out retCode)
             * WmiMethodId 12: GetGpuPowerOffsets(out delta, out boost, out retCode)
             */
            Method (_INI, 0, Serialized)
            {
                If (CondRefOf (\_SB.M1CP)) { \_SB.M1CP = 0xFF }
                If (CondRefOf (\_SB.M2CP)) { \_SB.M2CP = 0xFF }
                If (CondRefOf (\_SB.M3CP)) { \_SB.M3CP = 0xFF }
                If (CondRefOf (\_SB.M4CP)) { \_SB.M4CP = 0xFF }
                If (CondRefOf (\_SB.M5CP)) { \_SB.M5CP = 0xFF }
                If (CondRefOf (\_SB.NPCF.ATPP)) { \_SB.NPCF.ATPP = 0x07F8 }
            }
            // Shared writer: byte-sized mode entries, 125 mW NPCF transport units.
            Method (GPOF, 2, Serialized)
            {
                If ((Arg0 > 255) || (Arg1 > 255)) { Return (One) }
                If (!CondRefOf (\_SB.NPCF.ACBT)) { Return (One) }
                If (!CondRefOf (\_SB.NPCF.AMAT)) { Return (One) }
                If (!CondRefOf (\_SB.NPCF.ATPP)) { Return (One) }
                // Update active NPCF registers in 125mW units (watts * 8)
                If (CondRefOf (\_SB.NPCF.ACBT))
                {
                    \_SB.NPCF.ACBT = (Arg0 * 0x08)
                    \_SB.NPCF.AMAT = (Arg1 * 0x08)
                    \_SB.NPCF.ATPP = 0x07F8
                }

                // Update ERM4 thermal mode table
                If (CondRefOf (\_SB.CAUM))
                {
                    Switch (ToInteger (\_SB.CAUM))
                    {
                        Case (Zero) // Turbo (M4)
                        {
                            If (CondRefOf (\_SB.M4CT)) { \_SB.M4CT = Arg0 }
                            If (CondRefOf (\_SB.M4DB)) { \_SB.M4DB = Arg1 }
                            If (CondRefOf (\_SB.M4CP)) { \_SB.M4CP = 0xFF }
                        }
                        Case (One) // Performance (M3)
                        {
                            If (CondRefOf (\_SB.M3CT)) { \_SB.M3CT = Arg0 }
                            If (CondRefOf (\_SB.M3DB)) { \_SB.M3DB = Arg1 }
                            If (CondRefOf (\_SB.M3CP)) { \_SB.M3CP = 0xFF }
                        }
                        Case (0x02) // Balanced (M2)
                        {
                            If (CondRefOf (\_SB.M2CT)) { \_SB.M2CT = Arg0 }
                            If (CondRefOf (\_SB.M2DB)) { \_SB.M2DB = Arg1 }
                            If (CondRefOf (\_SB.M2CP)) { \_SB.M2CP = 0xFF }
                        }
                        Case (0x04) // Eco (M5)
                        {
                            \_SB.M5CT = Arg0
                            \_SB.M5DB = Arg1
                            \_SB.M5CP = 0xFF
                        }
                        Case (0x03) // Quiet (M1)
                        {
                            If (CondRefOf (\_SB.M1CT)) { \_SB.M1CT = Arg0 }
                            If (CondRefOf (\_SB.M1DB)) { \_SB.M1DB = Arg1 }
                            If (CondRefOf (\_SB.M1CP)) { \_SB.M1CP = 0xFF }
                        }
                    }
                }
                Else
                {
                    If (CondRefOf (\_SB.M4CT)) { \_SB.M4CT = Arg0 }
                    If (CondRefOf (\_SB.M4DB)) { \_SB.M4DB = Arg1 }
                    If (CondRefOf (\_SB.M4CP)) { \_SB.M4CP = 0xFF }
                }

                // Notify NVIDIA driver of power limit change
                If (CondRefOf (\_SB.NPCF))
                {
                    Notify (\_SB.NPCF, 0xC0)
                    Notify (\_SB.NPCF, 0xC1)
                }

                Return (Zero)
            }

            Method (WM01, 3, Serialized)
            {
                Name (PKG1, Package (0x01) { Zero })
                Name (PKG2, Package (0x02) { Zero, Zero })
                Name (PKG3, Package (0x03) { Zero, Zero, Zero })
                Name (PKG4, Package (0x04) { Zero, Zero, Zero, Zero })

                Switch (ToInteger (Arg1))
                {
                    Case (One) // GetVersion
                    {
                        PKG1 [Zero] = 0x0201
                        Return (PKG1)
                    }
                    Case (0x02) // Ping
                    {
                        PKG1 [Zero] = 0x50524559
                        Return (PKG1)
                    }
                    Case (0x03) // SetCpuPowerLimits
                    {
                        Local2 = Zero
                        If (ObjectType (Arg2) == 0x03) // Buffer
                        {
                            If (SizeOf (Arg2) >= 0x08)
                            {
                                CreateDWordField (Arg2, Zero, P1MW)
                                CreateDWordField (Arg2, 0x04, P2MW)
                                Local0 = P1MW
                                Local1 = P2MW
                            }
                            If (SizeOf (Arg2) >= 0x0C)
                            {
                                CreateDWordField (Arg2, 0x08, TAUW)
                                Local2 = TAUW
                            }
                        }
                        Else
                        {
                            Local0 = DerefOf (Arg2 [Zero])
                            Local1 = DerefOf (Arg2 [One])
                            If (SizeOf (Arg2) >= 0x03)
                            {
                                Local2 = DerefOf (Arg2 [0x02])
                            }
                        }

                        If (CondRefOf (\PL1E))
                        {
                            \PL1E = One
                            \PPL1 = (Local0 / 0x7D)
                            \PL2E = One
                            \PPL2 = (Local1 / 0x7D)
                            If (Local2)
                            {
                                \PL1T = (Local2 & 0x7F)
                            }

                            If (CondRefOf (\_TZ.TZ01))
                            {
                                Notify (\_TZ.TZ01, 0x81)
                            }
                            If (CondRefOf (\HIDA))
                            {
                                \HIDA ()
                            }
                            PKG1 [Zero] = Zero
                            Return (PKG1)
                        }
                        PKG1 [Zero] = One
                        Return (PKG1)
                    }
                    Case (0x04) // GetCpuPowerLimits
                    {
                        If (CondRefOf (\PPL1))
                        {
                            Local0 = (\PPL1 * 0x7D)
                            Local1 = (\PPL2 * 0x7D)
                            PKG4 [Zero] = Local0
                            PKG4 [One] = Local1
                            PKG4 [0x02] = (\PL1T & 0x7F)
                            PKG4 [0x03] = Zero
                            Return (PKG4)
                        }
                        PKG4 [Zero] = Zero
                        PKG4 [One] = Zero
                        PKG4 [0x02] = Zero
                        PKG4 [0x03] = One
                        Return (PKG4)
                    }
                    Case (0x05) // SetGpuPowerLimit
                    {
                        If (ObjectType (Arg2) == 0x03)
                        {
                            CreateDWordField (Arg2, Zero, TGW)
                            Local0 = TGW
                        }
                        ElseIf (ObjectType (Arg2) == 0x04)
                        {
                            Local0 = DerefOf (Arg2 [Zero])
                        }
                        Else
                        {
                            Local0 = ToInteger (Arg2)
                        }

                        // Dynamically compute wattage delta above 85W base without hard-clamping upper bound
                        If (Local0 < 85)
                        {
                            Local1 = Zero // Target below base floor runs at base hardware limit
                        }
                        Else
                        {
                            Local1 = (Local0 - 85) // Total delta in Watts above 85W base
                        }

                        // Retain 15W Dynamic Boost headroom for targets above 100W so NVIDIA driver unlocks upper tier
                        If (Local1 > 15)
                        {
                            Local2 = (Local1 - 15) // Configurable TGP delta in Watts (ctgpOffsetmW)
                            Local3 = 15            // Dynamic Boost delta in Watts (maxOutputOffsetmW)
                        }
                        Else
                        {
                            Local2 = Local1        // Direct TGP delta in Watts
                            Local3 = Zero          // Zero Dynamic Boost
                        }


                        PKG1 [Zero] = GPOF (Local2, Local3)
                        Return (PKG1)
                    }
                    Case (0x06) // GetGpuPowerLimit
                    {
                        If (CondRefOf (\_SB.NPCF.ACBT))
                        {
                            Local0 = 85
                            Local0 += (\_SB.NPCF.ACBT / 0x08)
                            If (CondRefOf (\_SB.NPCF.AMAT))
                            {
                                Local0 += (\_SB.NPCF.AMAT / 0x08)
                            }
                            PKG2 [Zero] = Local0
                            PKG2 [One] = Zero
                            Return (PKG2)
                        }
                        PKG2 [Zero] = 85
                        PKG2 [One] = One
                        Return (PKG2)
                    }
                    Case (0x07) // SetGpuThermalTripPoint
                    {
                        If (ObjectType (Arg2) == 0x03)
                        {
                            CreateDWordField (Arg2, Zero, TGT)
                            Local0 = TGT
                        }
                        ElseIf (ObjectType (Arg2) == 0x04)
                        {
                            Local0 = DerefOf (Arg2 [Zero])
                        }
                        Else
                        {
                            Local0 = ToInteger (Arg2)
                        }

                        // Safe bounds: 70°C to 89°C (NVML GPU_MAX operating thermal limit)
                        If (Local0 < 70) { Local0 = 70 }
                        If (Local0 > 89) { Local0 = 89 }

                        If (CondRefOf (\_SB.NPCF.WMG3))
                        {
                            \_SB.NPCF.WMG3 = Local0
                            If (CondRefOf (\_SB.NPCF))
                            {
                                Notify (\_SB.NPCF, 0xC0)
                                Notify (\_SB.NPCF, 0xC1)
                            }
                            PKG1 [Zero] = Zero
                            Return (PKG1)
                        }
                        PKG1 [Zero] = One
                        Return (PKG1)
                    }
                    Case (0x08) // GetGpuThermalTripPoint
                    {
                        If (CondRefOf (\_SB.NPCF.WMG3))
                        {
                            PKG2 [Zero] = \_SB.NPCF.WMG3
                            PKG2 [One] = Zero
                            Return (PKG2)
                        }
                        PKG2 [Zero] = 79 // Factory default 79°C
                        PKG2 [One] = One
                        Return (PKG2)
                    }
                    Case (0x0B) // SetGpuPowerOffsets: two independent uint32 watts
                    {
                        If (ObjectType (Arg2) != 0x03) { PKG1 [Zero] = One Return (PKG1) }
                        If (SizeOf (Arg2) < 8) { PKG1 [Zero] = One Return (PKG1) }
                        CreateDWordField (Arg2, Zero, DLTW)
                        CreateDWordField (Arg2, 0x04, BSTW)
                        PKG1 [Zero] = GPOF (DLTW, BSTW)
                        Return (PKG1)
                    }
                    Case (0x0C) // GetGpuPowerOffsets: actual ACPI values, not GPU telemetry
                    {
                        PKG3 [Zero] = Zero
                        PKG3 [One] = Zero
                        PKG3 [0x02] = One
                        If (CondRefOf (\_SB.NPCF.ACBT) && CondRefOf (\_SB.NPCF.AMAT))
                        {
                            PKG3 [Zero] = (\_SB.NPCF.ACBT / 0x08)
                            PKG3 [One] = (\_SB.NPCF.AMAT / 0x08)
                            PKG3 [0x02] = Zero
                        }
                        Return (PKG3)
                    }
                    Default
                    {
                        PKG1 [Zero] = One
                        Return (PKG1)
                    }
                }
            }
        }
    }
}
