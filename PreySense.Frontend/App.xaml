<Application x:Class="PreySense.Frontend.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:PreySense.Frontend.Services">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- PreySense Centralized Design System -->
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Typography.xaml" />
                <ResourceDictionary Source="Styles/Spacing.xaml" />
                <ResourceDictionary Source="Styles/Cards.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="AppWindowRenderingStyle" TargetType="{x:Type Window}">
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="WindowStyle" Value="None" />
                <Setter Property="AllowsTransparency" Value="False" />
                <Setter Property="Background" Value="{DynamicResource WindowBgBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WindowBgBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="services:WindowSystemShadow.Enable" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
