<Window Style="{DynamicResource AppWindowRenderingStyle}" x:Class="PreySense.Frontend.Views.DtsEqualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PreySense.Frontend.Controls"
        Title="PreySense • Equalizer"
        Width="640"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="VerticalEqualizerSliderStyle" TargetType="{x:Type Slider}" BasedOn="{StaticResource ReferenceBatterySliderStyle}">
            <Setter Property="MinHeight" Value="220"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid HorizontalAlignment="Center">
                            <Track Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <Control.Template>
                                            <ControlTemplate>
                                                <Border Width="5" CornerRadius="2.5" HorizontalAlignment="Center" Background="{DynamicResource ControlTrackFillBrush}"/>
                                            </ControlTemplate>
                                        </Control.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <Control.Template>
                                            <ControlTemplate>
                                                <Border Width="5" CornerRadius="2.5" HorizontalAlignment="Center" Background="{DynamicResource ControlTrackBrush}"/>
                                            </ControlTemplate>
                                        </Control.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Arrow">
                                        <Control.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Grid Width="26" Height="26" Background="{DynamicResource TransparentBrush}">
                                                    <Ellipse Name="ThumbBody" Width="16" Height="16" Stroke="{DynamicResource ControlThumbBorderBrush}" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource ControlThumbBrush}" RenderTransformOrigin="0.5,0.5">
                                                        <Ellipse.RenderTransform>
                                                            <ScaleTransform x:Name="ThumbScale" ScaleX="1.0" ScaleY="1.0"/>
                                                        </Ellipse.RenderTransform>
                                                        <UIElement.Effect>
                                                            <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="6" ShadowDepth="1" Opacity="0.5"/>
                                                        </UIElement.Effect>
                                                    </Ellipse>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Shape.StrokeThickness" Value="2.5"/>
                                                        <Setter TargetName="ThumbBody" Property="Shape.Fill" Value="{DynamicResource ControlThumbHoverBrush}"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.35" Duration="0:0:0.18" DecelerationRatio="0.3"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.35" Duration="0:0:0.18" DecelerationRatio="0.3"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18" AccelerationRatio="0.3"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18" AccelerationRatio="0.3"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="Thumb.IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Shape.StrokeThickness" Value="2.5"/>
                                                        <Setter TargetName="ThumbBody" Property="Shape.Fill" Value="{DynamicResource ControlThumbPressedBrush}"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.45" Duration="0:0:0.15" DecelerationRatio="0.3"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.45" Duration="0:0:0.15" DecelerationRatio="0.3"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18" AccelerationRatio="0.3"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18" AccelerationRatio="0.3"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Control.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{DynamicResource AppWindowShellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:WindowTitleBar Grid.Row="0" Title="Equalizer"
                                     Subtitle="{Binding SelectedEndpoint.Title, TargetNullValue=''}"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="{StaticResource WindowContentMargin}">
                    <controls:SettingSwitchRow Title="Equalizer"
                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              IsEnabled="{Binding CanEdit}"/>
                    <ItemsControl ItemsSource="{Binding Bands}" Margin="8,4,8,8" IsEnabled="{Binding SlidersEnabled}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" Margin="2,0">
                                    <TextBlock Text="{Binding ValueText}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,6"/>
                                    <Slider Style="{StaticResource VerticalEqualizerSliderStyle}"
                                            Orientation="Vertical"
                                            Height="220"
                                            HorizontalAlignment="Center"
                                            Value="{Binding Decibels, Mode=TwoWay}"
                                            Minimum="-10"
                                            Maximum="10"
                                            SmallChange="1"
                                            LargeChange="1"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"/>
                                    <TextBlock Text="{Binding Label}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <UniformGrid Grid.Row="2" Columns="2" Rows="1" Style="{StaticResource WindowFooterPanelStyle}">
                <Button Content="Apply" Style="{StaticResource WindowFooterButtonStyle}"
                        IsEnabled="{Binding CanEdit}"
                        Command="{Binding ApplySettingsCommand}"/>
                <Button Content="Save" Style="{StaticResource WindowFooterButtonStyle}"
                        IsEnabled="{Binding CanEdit}"
                        Command="{Binding SaveSettingsCommand}"/>
            </UniformGrid>
        </Grid>
    </Border>
</Window>
