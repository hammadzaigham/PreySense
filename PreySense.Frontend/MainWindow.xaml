<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PreySense.Frontend.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:PreySense.Frontend.ViewModels" xmlns:controls="clr-namespace:PreySense.Frontend.Controls" xmlns:local="clr-namespace:PreySense.Frontend" Title="PreySense" Icon="appicon.ico" Width="460" SizeToContent="Height" WindowStartupLocation="CenterScreen" Background="{DynamicResource TransparentBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFontFamily}" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Border Style="{DynamicResource AppWindowShellStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <controls:WindowTitleBar Grid.Row="0" Subtitle="v2.4.0">
        <controls:WindowTitleBar.Actions>
          <Button AutomationProperties.AutomationId="BtnSettings" Style="{StaticResource TitleBarButtonStyle}" Click="SettingsButton_Click">
            <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-settings-32.png" Width="14" Height="14" />
          </Button>
        </controls:WindowTitleBar.Actions>
      </controls:WindowTitleBar>
      <StackPanel Grid.Row="1" Margin="{StaticResource WindowContentMargin}">
        <Border Style="{StaticResource OriginalSectionPanelStyle}">
          <StackPanel>
            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-gauge-32.png" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Performance Mode" Style="{StaticResource OriginalSectionTitleStyle}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Style="{StaticResource OriginalStatusTextStyle}" Foreground="{DynamicResource TextOnAccentBrush}" HorizontalAlignment="Right" TextAlignment="Right" Margin="12,0,0,0">
                <Run Text="CPU: " />
                <Run Text="{Binding CpuTemp, Mode=OneWay}" />
                <Run Text="°C • " />
                <Run Text="{Binding CpuRpm, Mode=OneWay}" />
                <Run Text=" RPM" />
              </TextBlock>
            </Grid>
            <UniformGrid Columns="4" Rows="1" Margin="0,2,0,2">
              <Button AutomationProperties.AutomationId="BtnModeEcoQuiet" Command="{Binding SetModeCommand}" CommandParameter="{Binding EcoOrQuietModeParam}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonTileStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsEcoOrQuietActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModeQuietBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{x:Static local:ModeIconData.EcoGeometry}" Fill="{DynamicResource IconForegroundBrush}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,0,5">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Path}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Value="False" Binding="{Binding IsAcConnected}">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Path>
                  <Path Data="{x:Static local:ModeIconData.QuietGeometry}" Fill="{DynamicResource IconForegroundBrush}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,0,5">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Path}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding IsAcConnected}">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Path>
                  <TextBlock FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" Text="{Binding EcoOrQuietModeName}" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.AutomationId="BtnModeBalanced" CommandParameter="1" Command="{Binding SetModeCommand}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonTileStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsBalancedActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{x:Static local:ModeIconData.BalancedGeometry}" Fill="{DynamicResource IconForegroundBrush}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,0,5" />
                  <TextBlock Text="Balanced" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.AutomationId="BtnModePerformance" CommandParameter="4" Command="{Binding SetModeCommand}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonTileStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsPerformActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModePerformanceBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{x:Static local:ModeIconData.PerformanceGeometry}" Fill="{DynamicResource IconForegroundBrush}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,0,5" />
                  <TextBlock Text="Performance" FontSize="{DynamicResource FontSizeTile}" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.AutomationId="BtnModeTurbo" CommandParameter="5" Command="{Binding SetModeCommand}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonTileStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsTurboActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModeTurboBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{x:Static local:ModeIconData.TurboGeometry}" Fill="{DynamicResource IconForegroundBrush}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,0,5" />
                  <TextBlock Text="Turbo" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </UniformGrid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="{StaticResource StandardSectionMargin}">
          <StackPanel>
            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-video-card-32.png" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="GPU Mode" Style="{StaticResource OriginalSectionTitleStyle}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Style="{StaticResource OriginalStatusTextStyle}" Foreground="{DynamicResource TextOnAccentBrush}" HorizontalAlignment="Right" TextAlignment="Right" Margin="12,0,0,0">
                <Run Text="GPU: " />
                <Run Text="{Binding GpuTemp, Mode=OneWay}" />
                <Run Text="°C • " />
                <Run Text="{Binding GpuRpm, Mode=OneWay}" />
                <Run Text=" RPM" />
              </TextBlock>
            </Grid>
            <UniformGrid Columns="{Binding GpuModeTileColumns}" Rows="1" Margin="0,2,0,2">
              <Button Height="62" Margin="3" CommandParameter="1" Command="{Binding SetGpuMuxModeCommand}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsGpuAutoActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-automation-32.png" Width="20" Height="20" Margin="0,0,0,2" />
                  <TextBlock Text="Auto" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Height="62" Margin="3" CommandParameter="0" Command="{Binding SetGpuMuxModeCommand}" Visibility="{Binding ShowDdsGpuTiles, Converter={StaticResource BoolToVis}}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsGpuOptimusActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{x:Static local:ModeIconData.HybridGpuGeometry}"
                        Stroke="{DynamicResource IconForegroundBrush}"
                        StrokeThickness="1.8"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        Fill="Transparent"
                        Width="20"
                        Height="20"
                        Stretch="Uniform"
                        Margin="0,0,0,2" />
                  <TextBlock Text="Hybrid" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Height="62" Margin="3" CommandParameter="2" Command="{Binding SetGpuMuxModeCommand}" Visibility="{Binding ShowDdsGpuTiles, Converter={StaticResource BoolToVis}}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsGpuAdvancedOptimusActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModePerformanceBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-game-controller-48.png" Width="20" Height="20" Margin="0,0,0,2" />
                  <TextBlock Text="Advanced Optimus" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
              <Button Height="62" Margin="3" Command="{Binding SetBiosDiscreteGpuCommand}">
                <Button.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsBiosDiscreteGpuActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModePerformanceBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-video-card-32.png" Width="20" Height="20" Margin="0,0,0,2" />
                  <TextBlock Text="dGPU Only" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
            </UniformGrid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="{StaticResource StandardSectionMargin}">
          <StackPanel>
            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-laptop-32.png" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Refresh Rate" Style="{StaticResource OriginalSectionTitleStyle}" />
              </StackPanel>
              <TextBlock Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" Margin="12,0,0,0" Foreground="{DynamicResource TextOnAccentBrush}" Style="{StaticResource OriginalStatusTextStyle}" Text="{Binding DisplayPanelInfo}" />
            </Grid>
            <Grid Margin="0,2,0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>

              <Button Grid.Column="0" Height="38" HorizontalAlignment="Stretch" Margin="3,0,6,0" Command="{Binding ToggleAutoRefreshRateCommand}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsAutoRefreshRateEnabled}">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <TextBlock Text="Auto" FontSize="{DynamicResource FontSizeTile}" />
              </Button>

              <ComboBox Grid.Column="1" Height="38" Margin="0,0,3,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Padding="24,4"
                        FontSize="{DynamicResource FontSizeTile}"
                        ItemsSource="{Binding AvailableRefreshRates}"
                        SelectedItem="{Binding SelectedRefreshRateOption, Mode=TwoWay}"/>
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="0">
          <StackPanel>
            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-fan-32.png" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Fans" Style="{StaticResource OriginalSectionTitleStyle}" />
              </StackPanel>
            </Grid>
            <UniformGrid Columns="3" Rows="1" Margin="0,2,0,8">
              <Button AutomationProperties.AutomationId="BtnFanAuto" Height="38" Margin="3,0" CommandParameter="0" Command="{Binding SetFanModeCommand}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsAutoFanActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-automation-32.png" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock Text="Auto" FontSize="{DynamicResource FontSizeTile}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.AutomationId="BtnFanMax" Height="38" Margin="3,0" CommandParameter="1" Command="{Binding SetFanModeCommand}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsMaxFanActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModeTurboBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-fan-48.png" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock Text="Max" FontSize="{DynamicResource FontSizeTile}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.AutomationId="BtnFanCustom" Height="38" Margin="3,0" CommandParameter="2" Command="{Binding SetFanModeCommand}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsCustomFanActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-controls-32.png" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock Text="Custom" FontSize="{DynamicResource FontSizeTile}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </UniformGrid>
            <StackPanel Margin="0,4,0,0" Visibility="{Binding IsCustomFanActive, Converter={StaticResource BoolToVis}}">
              <controls:SettingSliderRow Title="CPU Fan"
                                         Margin="0,0,0,8"
                                         Value="{Binding CustomCpuFanPercent, Mode=TwoWay}"
                                         ValueText="{Binding CustomCpuFanPercent, StringFormat={}{0}%}"
                                         Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5"/>
              <controls:SettingSliderRow Title="GPU Fan"
                                         Margin="0"
                                         Value="{Binding CustomGpuFanPercent, Mode=TwoWay}"
                                         ValueText="{Binding CustomGpuFanPercent, StringFormat={}{0}%}"
                                         Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      <Grid Grid.Row="2" Margin="{StaticResource WindowFooterMargin}">
        <Grid.RowDefinitions>
          <RowDefinition Height="34"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="34"/>
        </Grid.RowDefinitions>
        <UniformGrid Grid.Row="0" Columns="3" HorizontalAlignment="Stretch">
          <Button AutomationProperties.AutomationId="BtnNavLighting" Style="{StaticResource WindowFooterButtonStyle}" Click="KeyboardButton_Click">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-color-32.png" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="Lighting" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.AutomationId="BtnNavGames" Style="{StaticResource WindowFooterButtonStyle}" Click="GamesButton_Click">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-controller-32.png" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="Games" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.AutomationId="BtnNavMetrics" Style="{StaticResource WindowFooterButtonStyle}" Click="MetricsButton_Click">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-soonvibes-32.png" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="Overlay" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </UniformGrid>
        <UniformGrid Grid.Row="2" Columns="3" HorizontalAlignment="Stretch">
          <Button AutomationProperties.AutomationId="BtnNavMode" Style="{StaticResource WindowFooterButtonStyle}" Click="ModeSettingsButton_Click">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-processor-32.png" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="Tuning" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.AutomationId="BtnNavAdvanced" Style="{StaticResource WindowFooterButtonStyle}" Click="AdvancedButton_Click">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-controls-32.png" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="Advanced" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.AutomationId="BtnNavQuit" Style="{StaticResource WindowFooterButtonStyle}" Click="QuitButton_Click">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-quit-32.png" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="Quit" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </UniformGrid>
      </Grid>
    </Grid>
  </Border>
</Window>
