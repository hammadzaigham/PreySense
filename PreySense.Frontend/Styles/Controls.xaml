<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PreySense.Frontend.Controls">
  <DropShadowEffect x:Key="WindowShadowEffect" Color="{DynamicResource ShadowColor}" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.55" />
  <DropShadowEffect x:Key="PopupShadowEffect" Color="{DynamicResource ShadowColor}" BlurRadius="12" ShadowDepth="3" Opacity="0.5" />
  <Thickness x:Key="StandardRowMargin">0,4,0,4</Thickness>
  <Thickness x:Key="StandardSectionMargin">0,0,0,8</Thickness>
  <BooleanToVisibilityConverter x:Key="BoolToVis" />
  <services:TranslateConverter xmlns:services="clr-namespace:PreySense.Frontend.Services" x:Key="TranslateConverter" />

  <Style TargetType="{x:Type controls:ThemedIcon}">
    <Setter Property="Foreground" Value="{DynamicResource IconForegroundBrush}" />
  </Style>

  <Style x:Key="AppWindowShellStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource WindowBgBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="10" />
    <Setter Property="Effect" Value="{DynamicResource WindowShadowEffect}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="WindowTitleBarStyle" TargetType="{x:Type Grid}">
    <Setter Property="Height" Value="30" />
    <!-- Transparent so the shell CornerRadius is not covered by a square fill. -->
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style x:Key="WarningBannerStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style x:Key="WarningBannerSubtleStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource WarningBannerStyle}">
    <Setter Property="Background" Value="{DynamicResource WarningSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
  </Style>
  <Style x:Key="SuccessBannerStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style TargetType="{x:Type Separator}">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="Background" Value="{DynamicResource BorderMainBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Separator}">
          <Border Height="1" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SegmentedTabRadioStyle" TargetType="{x:Type RadioButton}">
    <Setter Property="Background" Value="{DynamicResource ButtonRaisedBgBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSecondBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Margin" Value="3,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
              <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderMainBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ControlSelectedBorderBrush}"/>
              <Setter TargetName="border" Property="BorderThickness" Value="2"/>
              <Setter TargetName="border" Property="Background" Value="{DynamicResource ControlSelectedBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="OriginalRButtonTileStyle" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{DynamicResource ButtonRaisedBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonRaisedBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeTile}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="62" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="border" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="border" Property="Border.Background" Value="{DynamicResource ButtonHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="border" Property="Border.Background" Value="{DynamicResource ButtonSecondBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="border" Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="OriginalRButtonTileActiveStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource OriginalRButtonTileStyle}">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
  </Style>
  <Style x:Key="OriginalRButtonActionStyle" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{DynamicResource ButtonRaisedBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonRaisedBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="border" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="5">
            <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Margin="{TemplateBinding Control.Padding}" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="border" Property="Border.Background" Value="{DynamicResource ButtonHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="border" Property="Border.Background" Value="{DynamicResource ButtonSecondBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="border" Property="Background" Value="{DynamicResource DisabledControlBrush}" />
              <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderSecondBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="OriginalRButtonActionActiveStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource OriginalRButtonActionStyle}">
    <Setter Property="BorderBrush" Value="{DynamicResource ControlSelectedBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
  </Style>
  <Style x:Key="WindowFooterPanelStyle" TargetType="{x:Type UniformGrid}">
    <Setter Property="Margin" Value="{StaticResource WindowFooterMargin}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style x:Key="WindowFooterButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource OriginalRButtonActionStyle}">
    <Setter Property="Height" Value="34" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <!-- Minimal application scrollbar: a single narrow track and thumb, without Windows arrow buttons. -->
  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="5" />
    <Setter Property="MinWidth" Value="5" />
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Width="5" Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="3" Background="{DynamicResource BorderMainBrush}">
                  <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                      <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}" BasedOn="{StaticResource OriginalRButtonActionStyle}" />
  <Style x:Key="{x:Type controls:ActionButton}" TargetType="{x:Type controls:ActionButton}" BasedOn="{StaticResource OriginalRButtonActionStyle}">
    <Setter Property="Padding" Value="14,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:ActionButton}">
          <Border Name="border" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Margin="{TemplateBinding Control.Padding}">
              <controls:ThemedIcon Source="{TemplateBinding Icon}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                <controls:ThemedIcon.Style>
                  <Style TargetType="controls:ThemedIcon">
                    <Style.Triggers>
                      <Trigger Property="Source" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </controls:ThemedIcon.Style>
              </controls:ThemedIcon>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="border" Property="Border.Background" Value="{DynamicResource ButtonHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="border" Property="Border.Background" Value="{DynamicResource ButtonSecondBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="OriginalSectionTitlePanelStyle" TargetType="{x:Type Grid}">
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="OriginalSectionPanelStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="Border.Padding" Value="0,0,0,0" />
    <Setter Property="Margin" Value="{StaticResource StandardSectionMargin}" />
  </Style>
  <Style x:Key="ReferenceBatterySliderStyle" TargetType="{x:Type Slider}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Grid VerticalAlignment="Center">
            <Track Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                  <Control.Template>
                    <ControlTemplate>
                      <Border Height="5" CornerRadius="2.5" VerticalAlignment="Center" Background="{DynamicResource ControlTrackFillBrush}" />
                    </ControlTemplate>
                  </Control.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                  <Control.Template>
                    <ControlTemplate>
                      <Border Height="5" CornerRadius="2.5" Background="{DynamicResource ControlTrackBrush}" VerticalAlignment="Center" />
                    </ControlTemplate>
                  </Control.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Cursor="Arrow">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                      <Grid Width="26" Height="26" Background="{DynamicResource TransparentBrush}">
                        <Ellipse Name="ThumbBody" Width="16" Height="16" Stroke="{DynamicResource ControlThumbBorderBrush}" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource ControlThumbBrush}" RenderTransformOrigin="0.5,0.5">
                          <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="ThumbScale" ScaleX="1.0" ScaleY="1.0" />
                          </Ellipse.RenderTransform>
                          <UIElement.Effect>
                            <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="6" ShadowDepth="1" Opacity="0.5" />
                          </UIElement.Effect>
                        </Ellipse>
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter TargetName="ThumbBody" Property="Shape.StrokeThickness" Value="2.5" />
                          <Setter TargetName="ThumbBody" Property="Shape.Fill" Value="{DynamicResource ControlThumbHoverBrush}" />
                          <Trigger.EnterActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.35" Duration="0:0:0.18" DecelerationRatio="0.3"/>
                                <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.35" Duration="0:0:0.18" DecelerationRatio="0.3"/>
                              </Storyboard>
                            </BeginStoryboard>
                          </Trigger.EnterActions>
                          <Trigger.ExitActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18" AccelerationRatio="0.3"/>
                                <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18" AccelerationRatio="0.3"/>
                              </Storyboard>
                            </BeginStoryboard>
                          </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Thumb.IsDragging" Value="True">
                          <Setter TargetName="ThumbBody" Property="Shape.StrokeThickness" Value="2.5" />
                          <Setter TargetName="ThumbBody" Property="Shape.Fill" Value="{DynamicResource ControlThumbPressedBrush}" />
                          <Trigger.EnterActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.45" Duration="0:0:0.15" DecelerationRatio="0.3"/>
                                <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.45" Duration="0:0:0.15" DecelerationRatio="0.3"/>
                              </Storyboard>
                            </BeginStoryboard>
                          </Trigger.EnterActions>
                          <Trigger.ExitActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18" AccelerationRatio="0.3"/>
                                <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18" AccelerationRatio="0.3"/>
                              </Storyboard>
                            </BeginStoryboard>
                          </Trigger.ExitActions>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Control.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type Slider}" TargetType="{x:Type Slider}" BasedOn="{StaticResource ReferenceBatterySliderStyle}" />

  <Style x:Key="CompactValueTextBoxStyle" TargetType="{x:Type TextBox}">
    <Setter Property="Width" Value="72" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ButtonMainBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource IconForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMainBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource DisabledControlBrush}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderSecondBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ListBox}" TargetType="{x:Type ListBox}">
    <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSecondBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBox}">
          <Border Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="2">
            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" CanContentScroll="True">
              <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </ScrollViewer>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource DisabledControlBrush}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderSecondBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ListBoxItem}" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Border Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlSelectedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Rectangular Segmented Switch Control Style -->
  <Style x:Key="{x:Type controls:RectangularSwitch}" TargetType="{x:Type controls:RectangularSwitch}">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="56" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:RectangularSwitch}">
          <Border Name="PART_Outer" Background="{DynamicResource ButtonMainBrush}" BorderBrush="{DynamicResource BorderSecondBrush}" BorderThickness="1" CornerRadius="14" SnapsToDevicePixels="True" ClipToBounds="True" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" MinWidth="{TemplateBinding MinWidth}" MaxWidth="{TemplateBinding MaxWidth}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Left Segment (Off / ○) -->
              <Border Name="PART_Left" Grid.Column="0" Margin="2" CornerRadius="12" Background="Transparent" SnapsToDevicePixels="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBlock Name="PART_LeftText" Text="{TemplateBinding OffText}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="2,0" FontSize="{DynamicResource FontSizeControl}" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
              </Border>

              <!-- Right Segment (On / │) -->
              <Border Name="PART_Right" Grid.Column="1" Margin="2" CornerRadius="12" Background="Transparent" SnapsToDevicePixels="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBlock Name="PART_RightText" Text="{TemplateBinding OnText}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="2,0" FontSize="{DynamicResource FontSizeControl}" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <!-- When Checked (True / On / "I") -->
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="PART_Right" Property="Background" Value="{DynamicResource ControlActiveBrush}" />
              <Setter TargetName="PART_RightText" Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
              <Setter TargetName="PART_RightText" Property="FontWeight" Value="Bold" />
              <Setter TargetName="PART_Left" Property="Background" Value="Transparent" />
              <Setter TargetName="PART_LeftText" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
              <Setter TargetName="PART_LeftText" Property="FontWeight" Value="Normal" />
            </Trigger>
            <!-- When Unchecked (False / Off / "O") -->
            <Trigger Property="IsChecked" Value="False">
              <Setter TargetName="PART_Left" Property="Background" Value="{DynamicResource ButtonSecondBrush}" />
              <Setter TargetName="PART_LeftText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              <Setter TargetName="PART_LeftText" Property="FontWeight" Value="Bold" />
              <Setter TargetName="PART_Right" Property="Background" Value="Transparent" />
              <Setter TargetName="PART_RightText" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
              <Setter TargetName="PART_RightText" Property="FontWeight" Value="Normal" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="PART_Outer" Property="BorderBrush" Value="{DynamicResource BorderMainBrush}" />
              <Setter TargetName="PART_Outer" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="PART_Outer" Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Default Rectangular Switch Style for all CheckBoxes -->
  <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Optional Content / Label on Left -->
            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" RecognizesAccessKey="True" />

            <!-- Rectangular Switch [ O | I ] on Right -->
            <Border Name="PART_Outer" Grid.Column="1" Height="28" Width="56" Background="{DynamicResource ButtonMainBrush}" BorderBrush="{DynamicResource BorderSecondBrush}" BorderThickness="1" CornerRadius="14" SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>

                <!-- Left Segment (Off / ○) -->
                <Border Name="PART_Left" Grid.Column="0" Width="22" Height="22" Margin="3" CornerRadius="11" Background="Transparent" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Name="PART_LeftText" Text="○" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeControl}" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                </Border>

                <!-- Right Segment (On / │) -->
                <Border Name="PART_Right" Grid.Column="1" Width="22" Height="22" Margin="3" CornerRadius="11" Background="Transparent" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Name="PART_RightText" Text="│" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,3" FontSize="{DynamicResource FontSizeControl}" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                </Border>
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="PART_Right" Property="Background" Value="{DynamicResource ControlActiveBrush}" />
              <Setter TargetName="PART_RightText" Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
              <Setter TargetName="PART_RightText" Property="FontWeight" Value="Bold" />
              <Setter TargetName="PART_Left" Property="Background" Value="Transparent" />
              <Setter TargetName="PART_LeftText" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
              <Setter TargetName="PART_LeftText" Property="FontWeight" Value="Normal" />
            </Trigger>
            <Trigger Property="IsChecked" Value="False">
              <Setter TargetName="PART_Left" Property="Background" Value="{DynamicResource ButtonSecondBrush}" />
              <Setter TargetName="PART_LeftText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              <Setter TargetName="PART_LeftText" Property="FontWeight" Value="Bold" />
              <Setter TargetName="PART_Right" Property="Background" Value="Transparent" />
              <Setter TargetName="PART_RightText" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
              <Setter TargetName="PART_RightText" Property="FontWeight" Value="Normal" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="PART_Outer" Property="BorderBrush" Value="{DynamicResource BorderMainBrush}" />
              <Setter TargetName="PART_Outer" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="PART_Outer" Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="border" Background="{TemplateBinding Control.Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="border" Property="Border.Background" Value="{DynamicResource ButtonHoverBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="border" Property="Border.Background" Value="{DynamicResource ButtonSecondBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TitleBarCloseButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TitleBarButtonStyle}">
    <Setter Property="Height" Value="30" />
    <Setter Property="Width" Value="30" />
    <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="border" Background="{TemplateBinding Control.Background}" CornerRadius="0,8,0,0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="border" Property="Border.Background" Value="{DynamicResource DangerBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="border" Property="Border.Background" Value="{DynamicResource DangerPressedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ComboBoxItem}" TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Background" Value="{DynamicResource WindowBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeControl}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Border Name="border" MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="border" Property="Border.Background" Value="{DynamicResource ButtonHoverBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter TargetName="border" Property="Border.Background" Value="{DynamicResource ControlSelectedBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
    <Setter Property="Background" Value="{DynamicResource ButtonMainBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMainBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeControl}" />
    <Setter Property="Padding" Value="10,4,8,4" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Width" Value="Auto" />
    <Setter Property="MinWidth" Value="110" />
    <Setter Property="Height" Value="28" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="MaxDropDownHeight" Value="360" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource {x:Type ComboBoxItem}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid Name="MainGrid" SnapsToDevicePixels="true">
            <Popup Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=MainGrid}" PopupAnimation="None" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
              <Border Name="DropDownBorder" BorderThickness="1" CornerRadius="4" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderMainBrush}" Width="{Binding ActualWidth, ElementName=MainGrid}" MaxWidth="{Binding ActualWidth, ElementName=MainGrid}" SnapsToDevicePixels="True">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="DropDownShift" Y="0"/>
                </Border.RenderTransform>
                <Border.Resources>
                  <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource {x:Type ScrollBar}}">
                    <Setter Property="Margin" Value="-8,3,1,3" />
                  </Style>
                </Border.Resources>
                <UIElement.Effect>
                  <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="8" ShadowDepth="1" Opacity="0.35" RenderingBias="Performance" />
                </UIElement.Effect>
                <ScrollViewer Name="DropDownScrollViewer"
                              MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}"
                              CanContentScroll="True"
                              Focusable="False"
                              Padding="0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </ScrollViewer>
              </Border>
            </Popup>
            <ToggleButton Name="toggleButton"
                          Width="{Binding ActualWidth, ElementName=MainGrid}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{TemplateBinding Control.Background}"
                          Foreground="{TemplateBinding Control.Foreground}"
                          BorderBrush="{TemplateBinding Control.BorderBrush}"
                          BorderThickness="{TemplateBinding Control.BorderThickness}"
                          Focusable="false"
                          Cursor="Hand"
                          OverridesDefaultStyle="True"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                  <Border Name="border" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4">
                    <Grid Background="{DynamicResource TransparentBrush}">
                      <ContentPresenter Name="content" IsHitTestVisible="False" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}" HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType=ComboBox}}" Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}" SnapsToDevicePixels="{Binding SnapsToDevicePixels, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                      <Path Name="arrow" Data="M0,0 L4,4 L8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{DynamicResource IconForegroundBrush}" />
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="true">
                      <Setter TargetName="border" Property="Border.Background" Value="{DynamicResource ButtonHoverBrush}" />
                      <Setter TargetName="border" Property="Border.BorderBrush" Value="{DynamicResource BorderMainBrush}" />
                      <Setter TargetName="arrow" Property="Shape.Fill" Value="{DynamicResource TextPrimaryBrush}" />
                    </Trigger>
                    <Trigger Property="ToggleButton.IsChecked" Value="true">
                      <Setter TargetName="border" Property="Border.BorderBrush" Value="{DynamicResource ControlFocusedBorderBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="border" Property="Background" Value="{DynamicResource DisabledControlBrush}" />
                      <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderSecondBrush}" />
                      <Setter TargetName="arrow" Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                      <Setter TargetName="content" Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="False">
                      <Setter TargetName="border" Property="Background" Value="{DynamicResource DisabledControlBrush}" />
                      <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderSecondBrush}" />
                      <Setter TargetName="arrow" Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                      <Setter TargetName="content" Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}" />
                    </DataTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Control.Template>
            </ToggleButton>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="DropDownBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.11"/>
                    <DoubleAnimation Storyboard.TargetName="DropDownShift" Storyboard.TargetProperty="Y" From="-6" To="0" Duration="0:0:0.11" DecelerationRatio="0.7"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="DropDownBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                    <DoubleAnimation Storyboard.TargetName="DropDownShift" Storyboard.TargetProperty="Y" To="0" Duration="0"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource DisabledControlBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSecondBrush}" />
        <Setter Property="Opacity" Value="1" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Segmented Tab Switcher (e.g. Keyboard / Logo, CPU Tuning / GPU Tuning) -->
  <Style x:Key="{x:Type controls:LabeledTabSwitcher}" TargetType="{x:Type controls:LabeledTabSwitcher}">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:LabeledTabSwitcher}">
          <UniformGrid Columns="2" Rows="1">
            <RadioButton x:Name="PART_LeftRadio" Style="{StaticResource SegmentedTabRadioStyle}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <controls:ThemedIcon Source="{Binding LeftIcon, RelativeSource={RelativeSource TemplatedParent}}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                  <controls:ThemedIcon.Style>
                    <Style TargetType="controls:ThemedIcon">
                      <Style.Triggers>
                        <Trigger Property="Source" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </controls:ThemedIcon.Style>
                </controls:ThemedIcon>
                <TextBlock Text="{Binding LeftText, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="PART_RightRadio" Style="{StaticResource SegmentedTabRadioStyle}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <controls:ThemedIcon Source="{Binding RightIcon, RelativeSource={RelativeSource TemplatedParent}}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                  <controls:ThemedIcon.Style>
                    <Style TargetType="controls:ThemedIcon">
                      <Style.Triggers>
                        <Trigger Property="Source" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </controls:ThemedIcon.Style>
                </controls:ThemedIcon>
                <TextBlock Text="{Binding RightText, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
          </UniformGrid>
          <ControlTemplate.Triggers>
            <Trigger Property="SelectedIndex" Value="0">
              <Setter TargetName="PART_LeftRadio" Property="IsChecked" Value="True"/>
              <Setter TargetName="PART_RightRadio" Property="IsChecked" Value="False"/>
            </Trigger>
            <Trigger Property="SelectedIndex" Value="1">
              <Setter TargetName="PART_LeftRadio" Property="IsChecked" Value="False"/>
              <Setter TargetName="PART_RightRadio" Property="IsChecked" Value="True"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>

