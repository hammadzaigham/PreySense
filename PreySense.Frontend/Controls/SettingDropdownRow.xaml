<UserControl x:Class="PreySense.Frontend.Controls.SettingDropdownRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="400"
             x:Name="RootDropdownRow">
    <Grid HorizontalAlignment="Stretch" MinHeight="28" Margin="{DynamicResource StandardRowMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="{Binding Title, ElementName=RootDropdownRow}"
                   Style="{DynamicResource SettingLabelStyle}"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0" />

        <ComboBox x:Name="InnerComboBox" Grid.Column="1" VerticalAlignment="Center"
                  Width="{Binding DropdownWidth, ElementName=RootDropdownRow}"
                  MinWidth="{Binding DropdownMinWidth, ElementName=RootDropdownRow}"
                  Height="28" FontSize="{DynamicResource FontSizeControl}"
                  VerticalContentAlignment="Center"
                  ItemsSource="{Binding ItemsSource, ElementName=RootDropdownRow}"
                  SelectedItem="{Binding SelectedItem, ElementName=RootDropdownRow, Mode=TwoWay}"
                  SelectedIndex="{Binding SelectedIndex, ElementName=RootDropdownRow, Mode=TwoWay}"
                  SelectionChanged="InnerComboBox_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </Grid>
</UserControl>
