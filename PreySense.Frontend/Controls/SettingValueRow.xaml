<UserControl x:Class="PreySense.Frontend.Controls.SettingValueRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootValueRow">
    <Grid HorizontalAlignment="Stretch" Margin="{DynamicResource StandardRowMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{Binding Title, ElementName=RootValueRow}" Style="{DynamicResource SettingLabelStyle}" />
        </StackPanel>

        <Grid Grid.Column="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InnerValueBox"
                     Style="{DynamicResource CompactValueTextBoxStyle}"
                     AutomationProperties.AutomationId="{Binding ValueAutomationId, ElementName=RootValueRow}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Unit, ElementName=RootValueRow}"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
        </Grid>
    </Grid>
</UserControl>
