<UserControl x:Class="PreySense.Frontend.Controls.WindowTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="Transparent"
             HorizontalAlignment="Stretch">
    <Grid Style="{DynamicResource WindowTitleBarStyle}" MouseLeftButtonDown="TitleBar_MouseDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
            <Image Source="pack://application:,,,/appicon.ico" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="PreySense" Style="{DynamicResource WindowTitleTextStyle}"/>
            <TextBlock x:Name="TitleText" Style="{DynamicResource WindowSubtitleTextStyle}"/>
            <TextBlock x:Name="SubtitleText" Style="{DynamicResource WindowSubtitleTextStyle}"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <ContentPresenter Content="{Binding Actions, ElementName=Root}"/>
            <Button AutomationProperties.AutomationId="BtnClose"
                    Style="{DynamicResource TitleBarCloseButtonStyle}"
                    Content="✕"
                    FontSize="{DynamicResource FontSizeTitle}"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
