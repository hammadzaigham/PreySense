<Window Style="{DynamicResource AppWindowRenderingStyle}" x:Class="PreySense.Frontend.Views.KeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PreySense.Frontend.Controls"
        mc:Ignorable="d"
        Title="PreySense • Lighting"
        Width="500"
        SizeToContent="Height"
        MaxHeight="900"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        ResizeMode="NoResize">

    <Window.Resources>
        <controls:HexRgbColorConverter x:Key="DeviceHexColorConverter"/>
        <Style x:Key="ZoneColorButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <Grid>
                                <Border Name="hover" Background="Transparent" CornerRadius="4"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hover" Property="Background" Value="#44000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Hex TextBox Style -->
        <Style x:Key="HexTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource ButtonMainBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSecondBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderMainBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LightingDeviceTabStyle" TargetType="{x:Type RadioButton}">
          <Setter Property="Background" Value="{DynamicResource ButtonRaisedBgBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource ButtonRaisedBorderBrush}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
          <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
          <Setter Property="FrameworkElement.Cursor" Value="Hand" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="Height" Value="36" />
          <Setter Property="Padding" Value="4,0" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type RadioButton}">
                <Border Name="border" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="5">
                  <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Margin="{TemplateBinding Control.Padding}" RecognizesAccessKey="True" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Border.Background" Value="{DynamicResource ButtonHoverBrush}" />
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Border.Background" Value="{DynamicResource ButtonSecondBrush}" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="border" Property="Background" Value="{DynamicResource DisabledControlBrush}" />
                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderSecondBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                    <Setter Property="Cursor" Value="Arrow" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              <Setter Property="BorderThickness" Value="{DynamicResource SelectedControlBorderThickness}"/>
            </Trigger>
          </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Style="{DynamicResource AppWindowShellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Main Content -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <controls:WindowTitleBar Grid.Row="0" Title="Lighting"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="{StaticResource WindowContentMargin}">

                <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="0,0,0,8">
                    <controls:SettingActionRow Title="Lighting Mode Settings" ActionText="Open" Click="LightingSettings_Click"/>
                </Border>
                <Separator HorizontalAlignment="Stretch" Margin="0,2,0,12"/>

                <!-- Detected devices replace Keyboard/Logo when OEM lighting targets are present. -->
                <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="0,0,0,8"
                        Visibility="{Binding ShowLightingDeviceTabs, Converter={StaticResource BoolToVis}}">
                    <ListBox ItemsSource="{Binding LightingDevices}" SelectedItem="{Binding SelectedLightingDevice, Mode=TwoWay}"
                             SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="0"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="{Binding DataContext.LightingDeviceTabColumns, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource LightingDeviceTabStyle}" GroupName="LightingDeviceTabs"
                                             IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"
                                             HorizontalAlignment="Stretch" Margin="0">
                                    <TextBlock Text="{Binding DisplayName, Converter={StaticResource TranslateConverter}}" Margin="4,0"
                                               TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Stretch"/>
                                </RadioButton>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Fallback Keyboard/Logo tabs when discovery finds no OEM devices. -->
                <controls:LabeledTabSwitcher x:Name="TabLightingTarget"
                                             Visibility="{Binding ShowLegacyTargetTabs, Converter={StaticResource BoolToVis}}"
                                             Margin="{StaticResource StandardSectionMargin}"
                                             LeftText="Keyboard"
                                             RightText="Logo"
                                             LeftIcon="pack://application:,,,/Resources/icons8-keyboard-32.png"
                                             RightIcon="pack://application:,,,/Resources/icons8-laptop-32.png"
                                             SelectedIndex="{Binding SelectedLightingTab, Mode=TwoWay}"/>

                <!-- Single EC keyboard idle timeout (no separate Cover Logo timeout). -->
                <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="{StaticResource StandardSectionMargin}"
                        Visibility="{Binding ShowBacklightTimeout, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-controls-32.png" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Backlight Timeout" Style="{StaticResource OriginalSectionTitleStyle}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KbdTimeoutDisplay}" HorizontalAlignment="Right" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                        <Slider Minimum="0" Maximum="120" SmallChange="10" LargeChange="30" IsSnapToTickEnabled="True" TickFrequency="10"
                                Value="{Binding KbdTimeoutSeconds, Mode=TwoWay, Delay=150}"
                                Style="{StaticResource ReferenceBatterySliderStyle}"/>
                    </StackPanel>
                </Border>

                <!-- SECTION 1: KEYBOARD LIGHTING CONTROLS (4-zone / software effects) -->
                <StackPanel x:Name="SectionKeyboard" Visibility="{Binding IsLegacyKeyboardEditorVisible, Converter={StaticResource BoolToVis}}">


                    <!-- Lighting Mode Dropdown (Static vs Dynamic) - Clean Row Layout -->
                    <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="0,0,0,8">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Lighting Mode" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                            <ComboBox Grid.Column="1" x:Name="ComboLightingMode" SelectedIndex="0" Width="210" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeControl}"
                                      SelectionChanged="ComboLightingMode_SelectionChanged">
                                <ComboBoxItem Content="Mode"/>
                                <ComboBoxItem Content="Static"/>
                                <ComboBoxItem Content="Dynamic"/>
                                <ComboBoxItem Content="Software"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border x:Name="PanelKeyboardBrightness" Margin="0,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource OriginalSectionPanelStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LightingEffectTag}" Value="MODE"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                <DataTrigger Binding="{Binding LightingEffectTag}" Value="HW:Mode"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-brightness-32.png" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Brightness" Style="{StaticResource OriginalSectionTitleStyle}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding RgbBrightness, StringFormat='{}{0}%'}" HorizontalAlignment="Right" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                        <Slider Minimum="0" Maximum="100" Value="{Binding RgbBrightness, Mode=TwoWay, Delay=150}"
                                SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                IsMoveToPointEnabled="True"/>
                    </StackPanel>
                </Border>



                    <!-- Zone Selection & Palette (Static Mode Only) -->
                    <Border x:Name="PanelStaticControls" Style="{StaticResource OriginalSectionPanelStyle}" Margin="0,0,0,8">
                        <StackPanel>
                            <!-- Synchronize All Zones Switch -->
                            <controls:SettingSwitchRow Title="Sync All Zones"
                                                      IsChecked="{Binding IsRgbSyncZonesEnabled, Mode=TwoWay}"
                                                      Margin="0,0,0,6"/>

                            <!-- Presets only apply to independent zones. -->
                            <Grid Margin="0,2,0,16">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRgbSyncZonesEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Preset Themes" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <ComboBox Grid.Column="1" x:Name="ComboPresetStatic" SelectedIndex="1" Width="210" Height="28" MaxDropDownHeight="360"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeControl}"
                                          SelectionChanged="ComboPresetStatic_SelectionChanged">
                                    <ComboBoxItem Content="Custom" Tag="Custom"/>
                                    <ComboBoxItem Content="Mode" Tag="Mode"/>
                                    <ComboBoxItem Content="Predator" Tag="Predator"/>
                                    <ComboBoxItem Content="Cyberpunk" Tag="Cyberpunk"/>
                                    <ComboBoxItem Content="Fire &amp; Ice" Tag="FireIce"/>
                                    <ComboBoxItem Content="Matrix" Tag="Matrix"/>
                                    <ComboBoxItem Content="Stealth" Tag="Stealth"/>
                                    <ComboBoxItem Content="Sunset" Tag="Sunset"/>
                                    <ComboBoxItem Content="Ocean" Tag="Ocean"/>
                                    <ComboBoxItem Content="Ember" Tag="Ember"/>
                                    <ComboBoxItem Content="Vaporwave" Tag="Vaporwave"/>
                                    <ComboBoxItem Content="Sakura" Tag="Sakura"/>
                                    <ComboBoxItem Content="Rainbow" Tag="Rainbow"/>
                                    <ComboBoxItem Content="Toxic" Tag="Toxic"/>
                                    <ComboBoxItem Content="Midnight" Tag="Midnight"/>
                                    <ComboBoxItem Content="Dracula" Tag="Dracula"/>
                                    <ComboBoxItem Content="Neon Haze" Tag="NeonHaze"/>
                                    <ComboBoxItem Content="Deep Space" Tag="DeepSpace"/>
                                    <ComboBoxItem Content="Inferno" Tag="Inferno"/>
                                    <ComboBoxItem Content="Cyber Storm" Tag="CyberStorm"/>
                                </ComboBox>
                            </Grid>

                            <!-- Zone Selector - Visible only when Sync All Zones is disabled -->
                            <StackPanel x:Name="PanelIndividualZones">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRgbSyncZonesEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="ButtonZone1" Content="Zone 1" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Background="{Binding Zone1HexColor}" Foreground="{Binding Zone1Foreground}"
                                            Click="Zone1_Click" Style="{StaticResource ZoneColorButtonStyle}"/>
                                    <Button Grid.Column="2" x:Name="ButtonZone2" Content="Zone 2" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Background="{Binding Zone2HexColor}" Foreground="{Binding Zone2Foreground}"
                                            Click="Zone2_Click" Style="{StaticResource ZoneColorButtonStyle}"/>
                                    <Button Grid.Column="4" x:Name="ButtonZone3" Content="Zone 3" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Background="{Binding Zone3HexColor}" Foreground="{Binding Zone3Foreground}"
                                            Click="Zone3_Click" Style="{StaticResource ZoneColorButtonStyle}"/>
                                    <Button Grid.Column="6" x:Name="ButtonZone4" Content="Zone 4" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Background="{Binding Zone4HexColor}" Foreground="{Binding Zone4Foreground}"
                                            Click="Zone4_Click" Style="{StaticResource ZoneColorButtonStyle}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Centered Color Wheel & Editable Hex Color Textbox -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,6,0,6">
                                <controls:ColorWheelControl x:Name="ColorWheel" Width="140" Height="140" HorizontalAlignment="Center"
                                                            ColorChanged="ColorWheel_ColorChanged"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
                                    <TextBlock Text="Color:" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Width="22" Height="22" CornerRadius="3" BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                                            Background="{Binding SelectedHexColor, FallbackValue='#00AEC7'}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TextHexColorInput" Text="{Binding SelectedHexColor, UpdateSourceTrigger=LostFocus}" Width="80" Height="26"
                                             Style="{StaticResource HexTextBoxStyle}"
                                             FontFamily="Consolas, Segoe UI" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center"
                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                             TextChanged="TextHexColorInput_TextChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Dynamic Hardware Effects (Dynamic Mode Only) -->
                    <Border x:Name="PanelDynamicControls" Visibility="Collapsed" Style="{StaticResource OriginalSectionPanelStyle}" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="{StaticResource StandardRowMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Effect" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <ComboBox Grid.Column="1" x:Name="ComboDynamicSelect" Width="210" Height="28" MaxDropDownHeight="360"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeControl}"
                                          SelectionChanged="ComboDynamicSelect_SelectionChanged">
                                    <ComboBoxItem Content="Breathing" Tag="HW:1"/>
                                    <ComboBoxItem Content="Neon Wave" Tag="HW:2"/>
                                    <ComboBoxItem Content="Color Wave" Tag="HW:3"/>
                                    <ComboBoxItem Content="Ripple" Tag="HW:4"/>
                                    <ComboBoxItem Content="Zoom" Tag="HW:5"/>
                                    <ComboBoxItem Content="Snake" Tag="HW:6"/>
                                    <ComboBoxItem Content="Disco" Tag="HW:7"/>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="{StaticResource StandardRowMargin}"
                                  Visibility="{Binding HasKeyboardLightingDirection, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Direction" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Width="210" Height="28" ItemsSource="{Binding KeyboardLightingDirections}"
                                          SelectedValuePath="Value" SelectedValue="{Binding KeyboardLightingDirection}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name, Converter={StaticResource TranslateConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <!-- Dynamic Animation Speed -->
                            <Grid Margin="{StaticResource StandardRowMargin}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-animation-32.png" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Animation Speed" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding KeyboardAnimationSpeedLevel}" HorizontalAlignment="Right" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <Slider Grid.Row="1" Minimum="1" Maximum="10" Value="{Binding KeyboardAnimationSpeedLevel, Mode=TwoWay, Delay=150}"
                                        SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Software Effects (Software Mode Only) -->
                    <Border x:Name="PanelSoftwareControls" Visibility="Collapsed" Style="{StaticResource OriginalSectionPanelStyle}" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="{StaticResource StandardRowMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Effect" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <ComboBox Grid.Column="1" x:Name="ComboSoftwareSelect" Width="210" Height="28" MaxDropDownHeight="360"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeControl}"
                                          SelectionChanged="ComboSoftwareSelect_SelectionChanged">
                                    <ComboBoxItem Content="Rainbow Cycle" Tag="DYN:RainbowCycle"/>
                                    <ComboBoxItem Content="Police Strobe" Tag="DYN:PoliceStrobe"/>
                                    <ComboBoxItem Content="Fire Ember" Tag="DYN:FireEmber"/>
                                    <ComboBoxItem Content="Matrix Cascade" Tag="DYN:MatrixCascade"/>
                                    <ComboBoxItem Content="Cylon Scanner" Tag="DYN:CylonScanner"/>
                                    <ComboBoxItem Content="Aurora Drift" Tag="DYN:AuroraDrift"/>
                                    <ComboBoxItem Content="Heartbeat" Tag="DYN:Heartbeat"/>
                                    <ComboBoxItem Content="Lightning Storm" Tag="DYN:LightningStorm"/>
                                    <ComboBoxItem Content="Starlight" Tag="DYN:Starlight"/>
                                    <ComboBoxItem Content="Neon Pulse" Tag="DYN:NeonPulse"/>
                                    <ComboBoxItem Content="Plasma Orb" Tag="DYN:PlasmaOrb"/>
                                    <ComboBoxItem Content="Glitch Storm" Tag="DYN:GlitchStorm"/>
                                    <ComboBoxItem Content="Bio Hazard" Tag="DYN:BioHazard"/>
                                    <ComboBoxItem Content="Solar Flare" Tag="DYN:SolarFlare"/>
                                </ComboBox>
                            </Grid>

                            <!-- Software Animation Speed -->
                            <Grid Margin="{StaticResource StandardRowMargin}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-animation-32.png" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Animation Speed" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RgbSpeed}" HorizontalAlignment="Right" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <Slider Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding RgbSpeed, Mode=TwoWay, Delay=150}"
                                        SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- SECTION 2: LOGO BACKLIGHT CONTROLS -->
                <StackPanel x:Name="SectionCover" Visibility="{Binding IsLegacyCoverEditorVisible, Converter={StaticResource BoolToVis}}">

                    <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="0,0,0,8">
                        <controls:SettingSwitchRow Title="Sync With Keyboard"
                                                  IsChecked="{Binding IsCoverSyncWithKeyboard, Mode=TwoWay}"/>
                    </Border>

                    <Border x:Name="PanelCoverEffectMode" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource OriginalSectionPanelStyle}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCoverSyncWithKeyboard}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Lighting Mode" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                            <ComboBox Grid.Column="1" x:Name="ComboCoverMode" Width="210" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeControl}"
                                      SelectionChanged="ComboCoverMode_SelectionChanged">
                                <ComboBoxItem Content="Mode" Tag="4"/>
                                <ComboBoxItem Content="Static" Tag="1"/>
                                <ComboBoxItem Content="Breathing" Tag="2"/>
                                <ComboBoxItem Content="Neon" Tag="3"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border x:Name="PanelCoverBrightness" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource OriginalSectionPanelStyle}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCoverSyncWithKeyboard}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CoverLightingMode}" Value="4"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-brightness-32.png" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Brightness" Style="{StaticResource OriginalSectionTitleStyle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CoverBrightness, StringFormat='{}{0}%'}" HorizontalAlignment="Right" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="100" Value="{Binding CoverBrightness, Mode=TwoWay, Delay=150}"
                                    SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                    IsMoveToPointEnabled="True"/>
                        </StackPanel>
                    </Border>

                    <!-- Logo Lighting Mode -->


                    <!-- Logo presets and color wheel — Static only; Breathing/Neon show speed instead -->
                    <Border x:Name="PanelCoverColorWheel" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource OriginalSectionPanelStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsCoverSyncWithKeyboard}" Value="False"/>
                                            <Condition Binding="{Binding CoverLightingMode}" Value="1"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,2,0,8">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCoverSyncWithKeyboard}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Preset Themes" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <ComboBox Grid.Column="1" x:Name="ComboCoverPresets" Width="210" Height="28" MaxDropDownHeight="360"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeControl}"
                                          SelectionChanged="ComboCoverPresets_SelectionChanged">
                                    <ComboBoxItem Content="Custom" Tag="Custom"/>
                                    <ComboBoxItem Content="Predator" Tag="Predator"/>
                                    <ComboBoxItem Content="Hellfire Red" Tag="Fire"/>
                                    <ComboBoxItem Content="Tactical Amber" Tag="Amber"/>
                                    <ComboBoxItem Content="Cyber Neon" Tag="Neon"/>
                                    <ComboBoxItem Content="Matrix Green" Tag="Matrix"/>
                                    <ComboBoxItem Content="Arctic White" Tag="White"/>
                                    <ComboBoxItem Content="Deep Violet" Tag="Purple"/>
                                    <ComboBoxItem Content="Sunset Orange" Tag="Sunset"/>
                                    <ComboBoxItem Content="Ocean Blue" Tag="Ocean"/>
                                    <ComboBoxItem Content="Sakura Pink" Tag="Sakura"/>
                                    <ComboBoxItem Content="Toxic Lime" Tag="Toxic"/>
                                    <ComboBoxItem Content="Lava Orange" Tag="Lava"/>
                                    <ComboBoxItem Content="Midnight Indigo" Tag="Midnight"/>
                                    <ComboBoxItem Content="Ice Blue" Tag="Ice"/>
                                    <ComboBoxItem Content="Vaporwave Pink" Tag="Vapor"/>
                                </ComboBox>
                            </Grid>

                            <!-- Centered Color Wheel & Editable Hex Textbox for Logo -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,6,0,6">
                                <controls:ColorWheelControl x:Name="CoverColorWheel" Width="140" Height="140" HorizontalAlignment="Center"
                                                            ColorChanged="CoverColorWheel_ColorChanged"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
                                    <TextBlock Text="Color:" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Width="22" Height="22" CornerRadius="3" BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                                            Background="{Binding CoverHexColor, FallbackValue='#00AEC7'}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TextCoverHexColorInput" Text="{Binding CoverHexColor, UpdateSourceTrigger=LostFocus}" Width="80" Height="26"
                                             Style="{StaticResource HexTextBoxStyle}"
                                             FontFamily="Consolas, Segoe UI" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center"
                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                             TextChanged="TextCoverHexColorInput_TextChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Logo Animation Speed (Visible for Breathing and Neon) -->
                    <Border x:Name="PanelCoverSpeed" Visibility="Collapsed" Style="{StaticResource OriginalSectionPanelStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-animation-32.png" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Animation Speed" Style="{StaticResource OriginalSectionTitleStyle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LogoAnimationSpeedLevel}" HorizontalAlignment="Right" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,2">
                                <Slider Minimum="1" Maximum="5" Value="{Binding LogoAnimationSpeedLevel, Mode=TwoWay, Delay=150}"
                                        SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- SECTION 3: OEM device editor (Mode key, lightbars, per-key keyboards, etc.) -->
                <StackPanel Visibility="{Binding IsDeviceLightingEditorVisible, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="0,0,0,8"
                            Visibility="{Binding IsModeKeyLightingDevice, Converter={StaticResource BoolToVis}}">
                        <controls:SettingSwitchRow Title="Sync With Keyboard"
                                                   IsChecked="{Binding IsModeKeySyncWithKeyboard, Mode=TwoWay}"/>
                    </Border>

                    <Border Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource OriginalSectionPanelStyle}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModeKeySyncWithKeyboard}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Effect" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LightingDeviceModes}" SelectedItem="{Binding SelectedLightingDeviceMode}"
                                      DisplayMemberPath="Name" MinWidth="210" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      FontSize="{DynamicResource FontSizeControl}"/>
                        </Grid>
                    </Border>

                    <Border Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource OriginalSectionPanelStyle}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModeKeySyncWithKeyboard}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsModeKeyFollowMode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-brightness-32.png" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Brightness" Style="{StaticResource OriginalSectionTitleStyle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DeviceLightingBrightness, StringFormat='{}{0}%'}" HorizontalAlignment="Right" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="100"
                                    SmallChange="{Binding DeviceLightingBrightnessStep}"
                                    LargeChange="{Binding DeviceLightingBrightnessStep}"
                                    TickFrequency="{Binding DeviceLightingBrightnessStep}"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding DeviceLightingBrightness, Delay=150}"
                                    IsMoveToPointEnabled="True"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="0,0,0,8"
                            Visibility="{Binding HasDeviceLightingSpeed, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-animation-32.png" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Animation Speed" Style="{StaticResource OriginalSectionTitleStyle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DeviceLightingSpeedLevel}" HorizontalAlignment="Right" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Slider Minimum="{Binding DeviceLightingSpeedMinimum}" Maximum="{Binding DeviceLightingSpeedMaximum}"
                                    SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding DeviceLightingSpeedLevel, Delay=150}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,8" Visibility="{Binding HasDeviceLightingDirection, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Direction" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Width="210" Height="28" ItemsSource="{Binding DeviceLightingDirections}"
                                          SelectedValuePath="Value" SelectedValue="{Binding DeviceLightingDirection}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name, Converter={StaticResource TranslateConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <controls:SettingSwitchRow Title="Random colors" IsChecked="{Binding DeviceLightingRandomColors}"
                                Visibility="{Binding HasDeviceLightingRandomColors, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6"/>
                            <controls:SettingSwitchRow Title="Sync All LEDs" IsChecked="{Binding SyncAllBarLeds, Mode=TwoWay}"
                                Visibility="{Binding ShowSyncAllBarLeds, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6"/>



                            <StackPanel HorizontalAlignment="Center" Margin="0,2,0,6"
                                        Visibility="{Binding ShowDeviceColorFields, Converter={StaticResource BoolToVis}}">
                                <controls:ColorWheelControl Width="140" Height="140" HorizontalAlignment="Center" Margin="0,4,0,10"
                                    Visibility="{Binding ShowDeviceColorWheel, Converter={StaticResource BoolToVis}}"
                                    SelectedColor="{Binding DeviceLightingColorHex, Converter={StaticResource DeviceHexColorConverter}, Mode=TwoWay}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding ShowDeviceColorWheel, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Color:" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Width="22" Height="22" CornerRadius="3" BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                                            Background="{Binding DeviceLightingColorHex, FallbackValue='#00AEC7'}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding DeviceLightingColorHex, UpdateSourceTrigger=PropertyChanged}" Width="80" Height="26"
                                             Style="{StaticResource HexTextBoxStyle}" MaxLength="7"
                                             FontFamily="Consolas, Segoe UI" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowKeyboardLayout, Converter={StaticResource BoolToVis}}">
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                                    <controls:RgbKeyboardLayout KeysSource="{Binding LightingLedEditors}"
                                        CommonColorHex="{Binding DeviceLightingColorHex}" UseIndividualColors="{Binding DeviceLightingIndividualColors}"
                                        SelectedKeys="{Binding SelectedLightingKeys}"
                                        SelectedKey="{Binding SelectedLightingKey, Mode=TwoWay}"/>
                                </Viewbox>

                            </StackPanel>

                            <ListBox x:Name="IndividualLedGrid" ItemsSource="{Binding LightingLedEditors}"
                                     SelectedItem="{Binding SelectedLightingKey, Mode=TwoWay}"
                                     Visibility="{Binding ShowIndividualLedGrid, Converter={StaticResource BoolToVis}}"
                                     Background="Transparent" BorderThickness="0" Padding="0" Margin="-2,4,-2,0"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Margin" Value="2"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}" Background="{Binding ColorHex}" Foreground="{Binding ForegroundHex}"
                                                Tag="{Binding}" Click="DeviceLed_Click" HorizontalAlignment="Stretch">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ZoneColorButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Visibility="{Binding ShowIndividualLightingEditors, Converter={StaticResource BoolToVis}}">
                                <controls:ColorWheelControl x:Name="IndividualLightingColorWheel" Width="160" Height="160" HorizontalAlignment="Center" Margin="0,16,0,10"
                                    ColorPicked="DeviceKeyColor_Picked"
                                    IsEnabled="{Binding HasSelectedLightingKey}"
                                    SelectedColor="{Binding SelectedLightingKey.ColorHex, Converter={StaticResource DeviceHexColorConverter}, Mode=TwoWay}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            IsEnabled="{Binding HasSelectedLightingKey}" Margin="0,0,0,8">
                                    <TextBlock Text="Color:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="90" Height="26" Style="{StaticResource HexTextBoxStyle}" MaxLength="7"
                                             Text="{Binding SelectedLightingKey.ColorHex, UpdateSourceTrigger=LostFocus}"
                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                    </StackPanel>
                </ScrollViewer>
        </Grid>
    </Border>
</Window>
