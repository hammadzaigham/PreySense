<UserControl x:Class="PreySense.Frontend.Controls.SettingSwitchRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PreySense.Frontend.Controls"
             x:Name="RootSwitchRow">
    <Grid HorizontalAlignment="Stretch" Margin="{DynamicResource StandardRowMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{Binding Title, ElementName=RootSwitchRow}" Style="{DynamicResource SettingLabelStyle}" />
            <TextBlock Text="{Binding Description, ElementName=RootSwitchRow}"
                       Margin="0,2,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SettingDescriptionStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Description, ElementName=RootSwitchRow}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Description, ElementName=RootSwitchRow}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <controls:RectangularSwitch x:Name="InnerSwitch" Grid.Column="1" VerticalAlignment="Center"
                                    MinWidth="{Binding SwitchWidth, ElementName=RootSwitchRow}"
                                    IsChecked="{Binding IsChecked, ElementName=RootSwitchRow, Mode=TwoWay}"
                                    OnText="{Binding OnText, ElementName=RootSwitchRow}"
                                    OffText="{Binding OffText, ElementName=RootSwitchRow}"
                                    Command="{Binding Command, ElementName=RootSwitchRow}"
                                    CommandParameter="{Binding CommandParameter, ElementName=RootSwitchRow}" />
    </Grid>
</UserControl>
