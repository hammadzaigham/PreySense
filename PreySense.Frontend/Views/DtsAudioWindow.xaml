<Window Style="{DynamicResource AppWindowRenderingStyle}" x:Class="PreySense.Frontend.Views.DtsAudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PreySense.Frontend.Controls"
        Title="PreySense • DTS:X Ultra"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Border Style="{DynamicResource AppWindowShellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:WindowTitleBar Grid.Row="0" Title="DTS:X Ultra"/>

            <StackPanel Grid.Row="1" Margin="{StaticResource WindowContentMargin}">
                <ItemsControl ItemsSource="{Binding Dts.Endpoints}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <controls:SettingDropdownRow Title="{Binding Title}"
                                                             ItemsSource="{Binding Presets}"
                                                             SelectedIndex="{Binding SelectedPresetIndex, Mode=TwoWay}"
                                                             DropdownWidth="220"/>
                                <controls:SettingActionRow Title="Customize Sound Profile"
                                                           ActionText="Customize"
                                                           Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                                           Click="CustomizeAudio_Click"/>
                                <controls:SettingActionRow Title="Equalizer"
                                                           ActionText="Edit"
                                                           Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                                           Click="Equalizer_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Dts.Error, Converter={StaticResource TranslateConverter}}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Dts.Error}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Dts.Error}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <UniformGrid Grid.Row="2" Columns="1" Rows="1" Style="{StaticResource WindowFooterPanelStyle}">
                <Button Content="Reset to Factory Defaults" Style="{StaticResource WindowFooterButtonStyle}"
                        IsEnabled="{Binding Dts.IsAvailable}"
                        Click="FactoryReset_Click"/>
            </UniformGrid>
        </Grid>
    </Border>
</Window>
