<UserControl x:Class="PreySense.Frontend.Controls.SettingSwitchRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PreySense.Frontend.Controls"
             x:Name="RootSwitchRow">
    <Grid HorizontalAlignment="Stretch" Margin="{DynamicResource StandardRowMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
            <controls:ThemedIcon Source="{Binding Icon, ElementName=RootSwitchRow}"
                                 Foreground="{DynamicResource IconForegroundBrush}"
                                 Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                <controls:ThemedIcon.Style>
                    <Style TargetType="controls:ThemedIcon">
                        <Style.Triggers>
                            <Trigger Property="Source" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </controls:ThemedIcon.Style>
            </controls:ThemedIcon>
            <TextBlock Text="{Binding Title, ElementName=RootSwitchRow}"
                       Style="{DynamicResource SettingLabelStyle}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <controls:RectangularSwitch x:Name="InnerSwitch" Grid.Column="1" VerticalAlignment="Center"
                                    MinWidth="{Binding SwitchWidth, ElementName=RootSwitchRow}"
                                    IsChecked="{Binding IsChecked, ElementName=RootSwitchRow, Mode=OneWay}"
                                    OnText="{Binding OnText, ElementName=RootSwitchRow}"
                                    OffText="{Binding OffText, ElementName=RootSwitchRow}"
                                    Command="{Binding Command, ElementName=RootSwitchRow}"
                                    CommandParameter="{Binding CommandParameter, ElementName=RootSwitchRow}"
                                    Checked="InnerSwitch_Changed"
                                    Unchecked="InnerSwitch_Changed" />
    </Grid>
</UserControl>
